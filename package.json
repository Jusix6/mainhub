{
  "name": "mainhub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "fun": "wrangler dev --port 8787 --local-upstream fun.jxsi.ch --var DEV:1",
    "fun:www": "wrangler dev --port 8787 --local-upstream www.jxsi.ch --var DEV:1",
    "og": "node scripts/og-default.mjs",
    "logo": "node scripts/logo-icons.mjs",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/space-grotesk": "^5.0.0",
    "@fontsource/archivo-black": "^5.0.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "simple-icons": "^15.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.0.0",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "sharp@0.35.5": true
  }
}
