---
/**
 * The hub (/hub): business card hero, categories, featured projects,
 * latest updates, latest YouTube video and Twitch. The start page (/) is the card alone.
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CategoryStrip from '@/components/CategoryStrip.astro';
import UpdateCard from '@/components/UpdateCard.astro';
import ScheduleItem from '@/components/ScheduleItem.astro';
import LatestVideo from '@/components/LatestVideo.astro';
import LinkButton from '@/components/LinkButton.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { getPublishedUpdates } from '@/lib/updates';
import { getLatestVideo } from '@/lib/youtube';
import { getUpcomingAndPast, formatFull } from '@/lib/schedule';

const projects = await getCollection('projects');
const projectById = new Map(projects.map((p) => [p.id, p]));

const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const updates = (await getPublishedUpdates()).slice(0, 2);
const video = await getLatestVideo();
const { upcoming } = await getUpcomingAndPast();
const nextEvents = upcoming.slice(0, 3);
const nextStream = upcoming.find((e) => e.data.type === 'stream');
---

<Base title={UI.nav.home}>
  <section class="container hero">
    <BusinessCard class="hero__card" />
    <div class="hero__intro">
      <p class="meta">{SITE.tagline}</p>
      <h1 class="hero__title">
        Hi, I'm <span class="marker">{SITE.name}</span>.
      </h1>
      <p class="hero__bio">{SITE.bio}</p>
      <div class="hero__actions">
        <Button href="/projects" iconAfter="arrow" size="lg">{UI.actions.seeMyWork}</Button>
        <Button href="/links" color="--surface" icon="link" size="lg">{UI.nav.links}</Button>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="make-heading">
    <h2 id="make-heading" class="section-title">{UI.card.whatIMake}</h2>
    <CategoryStrip />
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-head">
      <h2 id="featured-heading">{UI.sections.featured}</h2>
      <Button href="/projects" color="--surface" iconAfter="arrow">{UI.actions.allProjects}</Button>
    </div>
    <ProjectGrid projects={featured} />
  </section>

  <section class="container section" aria-labelledby="fun-heading">
    <div class="section-head">
      <h2 id="fun-heading">{UI.fun.indexTitle}</h2>
      <Button href={SITE.fun.url} color="--surface" iconAfter="arrow">{UI.fun.allGames}</Button>
    </div>
    <div class="fun-grid">
      <a class="fun-card fun-card--colors" href={`${SITE.fun.url}/colors`}>
        <span class="fun-card__drops" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="fun-card__body">
          <span class="fun-card__tag">{UI.fun.hubNew}</span>
          <strong class="fun-card__title">{UI.fun.colors.title}</strong>
          <span>{UI.fun.hubColors}</span>
          <span class="fun-card__cta">
            {UI.fun.hubColorsCta}
            <Icon name="arrow" size={18} />
          </span>
        </span>
      </a>
      <a class="fun-card fun-card--flag" href={`${SITE.fun.url}/flag`}>
        <span class="fun-card__flag" aria-hidden="true"></span>
        <span class="fun-card__body">
          <span class="fun-card__tag">{UI.fun.hubDaily}</span>
          <strong class="fun-card__title">{UI.fun.flag.title}</strong>
          <span>{UI.fun.hubFlag}</span>
          <span class="fun-card__cta">
            {UI.fun.hubFlagCta}
            <Icon name="arrow" size={18} />
          </span>
        </span>
      </a>
      <a class="fun-card" href={`${SITE.fun.url}/the-button`}>
        <span class="fun-card__button" aria-hidden="true">{UI.fun.theButton.press}</span>
        <span class="fun-card__body">
          <strong class="fun-card__title">{UI.fun.theButton.title}</strong>
          <span>{UI.fun.hubTeaser}</span>
          <span class="fun-card__cta">
            {UI.fun.hubCta}
            <Icon name="arrow" size={18} />
          </span>
        </span>
      </a>
    </div>
  </section>

  {
    nextEvents.length > 0 && (
      <section class="container section" aria-labelledby="upcoming-heading">
        <div class="section-head">
          <h2 id="upcoming-heading">{UI.schedule.upcoming}</h2>
          <Button href="/schedule" color="--surface" iconAfter="arrow">
            {UI.schedule.seeAll}
          </Button>
        </div>
        <div>
          <ul class="event-list" data-upcoming>
            {nextEvents.map((e, i) => (
              <ScheduleItem event={e} project={e.data.project ? projectById.get(e.data.project.id) : undefined} index={i} compact />
            ))}
          </ul>
          <p class="event-empty" data-upcoming-empty hidden>
            {UI.schedule.empty}
          </p>
        </div>
      </section>
    )
  }

  <section class="container section split">
    {
      updates.length > 0 && (
        <div class="split__col" aria-labelledby="updates-heading">
          <div class="section-head">
            <h2 id="updates-heading">{UI.sections.latestUpdates}</h2>
            <Button href="/updates" color="--surface" iconAfter="arrow">
              {UI.sections.allUpdates}
            </Button>
          </div>
          <ul class="update-list">
            {updates.map((u, i) => (
              <UpdateCard update={u} project={u.data.project ? projectById.get(u.data.project.id) : undefined} index={i} />
            ))}
          </ul>
        </div>
      )
    }

    <div class="split__col" aria-labelledby="watch-heading">
      <div class="section-head">
        <h2 id="watch-heading">{video ? UI.sections.latestVideo : UI.sections.live}</h2>
      </div>
      {video && <LatestVideo video={video} />}
      <div class="twitch">
        <div class="twitch__text">
          <strong>{UI.sections.live}</strong>
          <p>
            {nextStream ? `${UI.schedule.nextStream}: ${formatFull(nextStream.data.start)}` : SITE.twitch.schedule || UI.sections.liveText}
          </p>
        </div>
        <LinkButton type="twitch" url={SITE.twitch.url} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero :global(.hero__card) {
    justify-self: center;
  }

  .hero__intro {
    display: grid;
    gap: var(--space-3);
  }

  .hero__title {
    font-size: var(--text-2xl);
  }

  .hero__bio {
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .section {
    margin-top: var(--space-6);
  }

  .section-title {
    margin-bottom: var(--space-4);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  /* Teasers for fun.jxsi.ch: the daily flag game and a mini version of The Button */
  .fun-grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 760px) {
    .fun-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* The newest game spans the full row above the other two */
    .fun-card--colors {
      grid-column: 1 / -1;
    }
  }

  .fun-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--c-pink);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition:
      transform var(--t-base) var(--ease-pop),
      box-shadow var(--t-base) var(--ease-pop);
  }

  .fun-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  .fun-card__button {
    --depth: 8px;
    display: grid;
    place-items: center;
    width: clamp(88px, 24vw, 120px);
    aspect-ratio: 1;
    margin-bottom: var(--depth);
    background: #ff3b30;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    box-shadow:
      0 var(--depth) 0 var(--ink),
      0 var(--depth) 0 var(--line) var(--ink);
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 3vw, 1.2rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      transform 70ms ease-out,
      box-shadow 70ms ease-out;
  }

  .fun-card:hover .fun-card__button {
    transform: translateY(calc(var(--depth) - 2px));
    box-shadow:
      0 2px 0 var(--ink),
      0 2px 0 var(--line) var(--ink);
  }

  .fun-card--flag {
    background: var(--c-green);
  }

  .fun-card--colors {
    background: var(--c-purple);
  }

  /* Yellow + blue drops that run together into green on hover */
  .fun-card__drops {
    position: relative;
    width: clamp(88px, 24vw, 120px);
    aspect-ratio: 1;
  }

  .fun-card__drops i {
    position: absolute;
    width: 52%;
    aspect-ratio: 1;
    border: var(--line) solid var(--ink);
    border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--t-slow) var(--ease-pop),
      opacity var(--t-base);
  }

  .fun-card__drops i:nth-child(1) {
    top: 4%;
    left: 0;
    background: #ffff14;
  }

  .fun-card__drops i:nth-child(2) {
    top: 4%;
    right: 0;
    background: #0343df;
  }

  .fun-card__drops i:nth-child(3) {
    bottom: 0;
    left: 24%;
    background: #39ad48;
    transform: scale(0.7);
  }

  .fun-card--colors:hover .fun-card__drops i:nth-child(1) {
    transform: translate(45%, 55%) scale(0.6);
    opacity: 0;
  }

  .fun-card--colors:hover .fun-card__drops i:nth-child(2) {
    transform: translate(-45%, 55%) scale(0.6);
    opacity: 0;
  }

  .fun-card--colors:hover .fun-card__drops i:nth-child(3) {
    transform: translate(0, -25%) scale(1.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .fun-card__drops i {
      transition: none;
    }
  }

  /* A half-painted Swiss flag: red and cross on the left, still unpainted on the right */
  .fun-card__flag {
    position: relative;
    width: clamp(88px, 24vw, 120px);
    aspect-ratio: 1;
    overflow: hidden;
    background:
      linear-gradient(#fff, #fff) center / 62% 19% no-repeat,
      linear-gradient(#fff, #fff) center / 19% 62% no-repeat,
      #d52b1e;
    border: var(--line) solid var(--ink);
    box-shadow: var(--shadow-sm);
    transform: rotate(-4deg);
    transition: transform var(--t-base) var(--ease-pop);
  }

  .fun-card__flag::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(#ece7da 0 25%, #f8f5ec 0 50%) 0 0 / 12px 12px;
    clip-path: polygon(58% 0, 100% 0, 100% 100%, 63% 100%, 55% 78%, 66% 56%, 54% 34%, 64% 14%);
    transition: clip-path var(--t-slow) var(--ease-out);
  }

  .fun-card--flag:hover .fun-card__flag {
    transform: rotate(3deg) scale(1.05);
  }

  .fun-card--flag:hover .fun-card__flag::after {
    clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%, 100% 78%, 100% 56%, 100% 34%, 100% 14%);
  }

  .fun-card__tag {
    justify-self: start;
    padding: 0 8px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .fun-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .fun-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .fun-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .split {
    display: grid;
    gap: var(--space-6);
  }

  .split__col {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .split__col .section-head {
    margin-bottom: 0;
  }

  .update-list,
  .event-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-empty {
    padding: var(--space-4);
    text-align: center;
    border: var(--line) dashed var(--ink);
    border-radius: var(--radius-lg);
    max-width: none;
  }

  .event-empty[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .event-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .twitch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--c-purple);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .twitch__text {
    display: grid;
    gap: 2px;
  }

  .twitch__text strong {
    font-family: var(--font-display);
    font-weight: 400;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
    }

    .hero :global(.hero__card) {
      justify-self: start;
    }

    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
