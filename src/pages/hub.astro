---
/**
 * The hub (/hub): business card hero, categories, featured projects,
 * latest updates, latest YouTube video and Twitch. The start page (/) is the card alone.
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CategoryStrip from '@/components/CategoryStrip.astro';
import UpdateCard from '@/components/UpdateCard.astro';
import ScheduleItem from '@/components/ScheduleItem.astro';
import LatestVideo from '@/components/LatestVideo.astro';
import LinkButton from '@/components/LinkButton.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { getPublishedUpdates } from '@/lib/updates';
import { getLatestVideo } from '@/lib/youtube';
import { getUpcomingAndPast, formatFull } from '@/lib/schedule';

const projects = await getCollection('projects');
const projectById = new Map(projects.map((p) => [p.id, p]));

const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const updates = (await getPublishedUpdates()).slice(0, 2);
const video = await getLatestVideo();
const { upcoming } = await getUpcomingAndPast();
const nextEvents = upcoming.slice(0, 3);
const nextStream = upcoming.find((e) => e.data.type === 'stream');
---

<Base title={UI.nav.home}>
  <section class="container hero">
    <BusinessCard class="hero__card" />
    <div class="hero__intro">
      <p class="meta">{SITE.tagline}</p>
      <h1 class="hero__title">
        Hi, I'm <span class="marker">{SITE.name}</span>.
      </h1>
      <p class="hero__bio">{SITE.bio}</p>
      <div class="hero__actions">
        <Button href="/projects" iconAfter="arrow" size="lg">{UI.actions.seeMyWork}</Button>
        <Button href="/links" color="--surface" icon="link" size="lg">{UI.nav.links}</Button>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="make-heading">
    <h2 id="make-heading" class="section-title">{UI.card.whatIMake}</h2>
    <CategoryStrip />
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-head">
      <h2 id="featured-heading">{UI.sections.featured}</h2>
      <Button href="/projects" color="--surface" iconAfter="arrow">{UI.actions.allProjects}</Button>
    </div>
    <ProjectGrid projects={featured} />
  </section>

  {
    nextEvents.length > 0 && (
      <section class="container section" aria-labelledby="upcoming-heading">
        <div class="section-head">
          <h2 id="upcoming-heading">{UI.schedule.upcoming}</h2>
          <Button href="/schedule" color="--surface" iconAfter="arrow">
            {UI.schedule.seeAll}
          </Button>
        </div>
        <div>
          <ul class="event-list" data-upcoming>
            {nextEvents.map((e, i) => (
              <ScheduleItem event={e} project={e.data.project ? projectById.get(e.data.project.id) : undefined} index={i} compact />
            ))}
          </ul>
          <p class="event-empty" data-upcoming-empty hidden>
            {UI.schedule.empty}
          </p>
        </div>
      </section>
    )
  }

  <section class="container section split">
    {
      updates.length > 0 && (
        <div class="split__col" aria-labelledby="updates-heading">
          <div class="section-head">
            <h2 id="updates-heading">{UI.sections.latestUpdates}</h2>
            <Button href="/updates" color="--surface" iconAfter="arrow">
              {UI.sections.allUpdates}
            </Button>
          </div>
          <ul class="update-list">
            {updates.map((u, i) => (
              <UpdateCard update={u} project={u.data.project ? projectById.get(u.data.project.id) : undefined} index={i} />
            ))}
          </ul>
        </div>
      )
    }

    <div class="split__col" aria-labelledby="watch-heading">
      <div class="section-head">
        <h2 id="watch-heading">{video ? UI.sections.latestVideo : UI.sections.live}</h2>
      </div>
      {video && <LatestVideo video={video} />}
      <div class="twitch">
        <div class="twitch__text">
          <strong>{UI.sections.live}</strong>
          <p>
            {nextStream ? `${UI.schedule.nextStream}: ${formatFull(nextStream.data.start)}` : SITE.twitch.schedule || UI.sections.liveText}
          </p>
        </div>
        <LinkButton type="twitch" url={SITE.twitch.url} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero :global(.hero__card) {
    justify-self: center;
  }

  .hero__intro {
    display: grid;
    gap: var(--space-3);
  }

  .hero__title {
    font-size: var(--text-2xl);
  }

  .hero__bio {
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .section {
    margin-top: var(--space-6);
  }

  .section-title {
    margin-bottom: var(--space-4);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .split {
    display: grid;
    gap: var(--space-6);
  }

  .split__col {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .split__col .section-head {
    margin-bottom: 0;
  }

  .update-list,
  .event-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-empty {
    padding: var(--space-4);
    text-align: center;
    border: var(--line) dashed var(--ink);
    border-radius: var(--radius-lg);
    max-width: none;
  }

  .event-empty[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .event-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .twitch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--c-purple);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .twitch__text {
    display: grid;
    gap: 2px;
  }

  .twitch__text strong {
    font-family: var(--font-display);
    font-weight: 400;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
    }

    .hero :global(.hero__card) {
      justify-self: start;
    }

    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
