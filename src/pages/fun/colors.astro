---
/**
 * Color Hunter: mix colours like paint and collect every named colour of the
 * xkcd colour survey. Board in the style of Infinite Craft: drag colours from
 * the side list onto the board and drop one drop onto another to merge them
 * (spectral.js, Kubelka-Munk, so yellow + blue = green). A mix counts for the
 * nearest named colour if it lands within that colour's tolerance (tighter for
 * rarer tiers), otherwise it is kept in the palette.
 * Collection book (families, ??? tiles, details, hints), milestones (palette
 * slots, ratios, magenta, cyan, thermometer), daily target for everyone,
 * sounds, export/import. Colour list: src/data/colors.json from
 * scripts/build-colors.mjs. Runs in the browser, progress in localStorage.
 */
import Fun from '@/layouts/Fun.astro';
import Icon from '@/components/Icon.astro';
import Sticker from '@/components/Sticker.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import og from '@/assets/fun/colors-og.png';

const T = UI.fun.colors;
const ogImage = new URL(og.src, SITE.fun.url).href;
const { title: _t, description: _d, tagline: _g, intro: _i, noJs: _n, ...strings } = T;
---

<Fun title={T.title} description={T.description} path="/colors" indexHref="./" image={ogImage} bare>
  <div class="container ch" data-ch data-mode="collect" data-strings={JSON.stringify(strings)}>
    <header class="topbar">
      <a class="topbar__fun" href="./" aria-label={UI.fun.indexTitle}><Sticker color="--c-pink" rotate={-4}>{UI.fun.title}</Sticker></a>
      <h1 class="topbar__title">{T.title}</h1>
      <div class="progress" aria-live="polite" title={T.intro}>
        <p class="progress__text"><strong data-count>0</strong> / <span data-total>0</span> <span class="progress__label">{T.found}</span></p>
        <div class="progress__bar"><span data-bar></span></div>
      </div>
      <div class="modes" role="group" aria-label={T.modeLabel}>
        <button class="mode" type="button" data-mode="collect" aria-pressed="true">{T.modeCollect}</button>
        <button class="mode" type="button" data-mode="daily" aria-pressed="false">{T.modeDaily}</button>
      </div>
      <a class="topbar__back" href={`${SITE.url}/hub`} aria-label={UI.fun.backToSite}>
        <span class="topbar__backtext">{UI.fun.backToSite}</span>
        <Icon name="arrow" size={16} />
      </a>
    </header>

    <section class="daily" data-only="daily" aria-labelledby="ch-daily-title">
      <div class="daily__target">
        <div class="daily__swatch" data-target></div>
        <div class="daily__info">
          <p class="daily__kicker" id="ch-daily-title" data-daily-title></p>
          <p class="daily__name" data-daily-name></p>
          <p class="daily__meta">{T.mixesLabel}: <strong data-daily-count>0</strong> <span data-daily-bonus></span></p>
        </div>
      </div>
      <p class="daily__intro" data-daily-intro>{T.dailyIntro}</p>
      <div class="match" data-match hidden>
        <span class="match__track"><span data-match-fill></span></span>
        <strong data-match-text></strong>
      </div>
      <p class="daily__row" data-daily-row aria-hidden="true"></p>
      <div class="daily__done" data-daily-done hidden>
        <p class="daily__solved" data-daily-solved></p>
        <p class="daily__stats" data-daily-stats></p>
        <button class="tbtn" type="button" data-daily-share>{T.share}</button>
        <p class="daily__stats" data-daily-countdown></p>
      </div>
    </section>

    <div class="app">
      <div class="board" data-board role="application" aria-label={T.boardLabel}>
        <div class="board__tools">
          <div class="ratios" role="group" aria-label={T.ratio} data-ratios hidden>
            <button type="button" data-ratio="1" aria-pressed="true">1:1</button>
            <button type="button" data-ratio="2" aria-pressed="false">1:2</button>
            <button type="button" data-ratio="3" aria-pressed="false">1:3</button>
          </div>
          <button class="tool" type="button" data-clear title={T.clearBoard} aria-label={T.clearBoard}>🧹</button>
          <button class="tool" type="button" data-sound aria-pressed="true" title={T.soundOn} aria-label={T.soundOn}>🔊</button>
          <button class="tool" type="button" data-fullscreen hidden title={T.fullscreen} aria-label={T.fullscreen}>⛶</button>
        </div>
        <p class="board__empty" data-board-empty>{T.boardEmpty}</p>
        <div class="board__status">
          <p class="verdict" data-verdict role="status">{T.howTo}</p>
          <div class="thermo" data-only="collect" data-thermo hidden>
            <span class="thermo__label">{T.thermo}</span>
            <span class="thermo__track"><span data-thermo-fill></span></span>
            <strong data-thermo-text></strong>
          </div>
        </div>
        <div class="board__layer" data-layer></div>
      </div>

      <aside class="side" data-side>
        <div class="side__top">
          <button class="tbtn" type="button" data-open-book>📖 {T.book}</button>
          <span class="tokens" data-only="collect" data-tokens></span>
        </div>
        <section class="side__section">
          <h2 class="side__title">{T.base}</h2>
          <div class="items" data-base></div>
        </section>
        <section class="side__section" data-only="daily">
          <h2 class="side__title">{T.todayMixes}</h2>
          <div class="items" data-today></div>
        </section>
        <section class="side__section" data-only="collect">
          <h2 class="side__title">{T.work}</h2>
          <div class="items" data-work></div>
        </section>
        <section class="side__section" data-only="collect">
          <h2 class="side__title">{T.collection} <span data-found-count></span></h2>
          <input class="search" type="search" data-search placeholder={T.search} aria-label={T.search} />
          <div class="items items--found" data-found></div>
        </section>
        <p class="side__hint">{T.dragHint}</p>
        <p class="foot">
          <button class="linkish" type="button" data-export>{T.exportSave}</button>
          <button class="linkish" type="button" data-import>{T.importSave}</button>
          <button class="linkish" type="button" data-reset>{T.reset}</button>
        </p>
      </aside>
    </div>
    <noscript><p class="side__hint">{T.noJs}</p></noscript>

    <!-- Discovery / unlock card -->
    <div class="reveal" data-reveal hidden>
      <div class="reveal__card" role="dialog" aria-modal="true" aria-labelledby="ch-reveal-name">
        <p class="reveal__kicker" data-reveal-kicker></p>
        <div class="reveal__swatch" data-reveal-swatch></div>
        <p class="reveal__name" id="ch-reveal-name" data-reveal-name></p>
        <p class="reveal__meta" data-reveal-meta></p>
        <ul class="reveal__extra" data-reveal-extra></ul>
        <button class="reveal__close" type="button" data-reveal-close>{T.close}</button>
      </div>
      <div class="confetti" data-confetti aria-hidden="true"></div>
    </div>

    <!-- Collection book -->
    <div class="book" data-book hidden>
      <div class="book__panel" role="dialog" aria-modal="true" aria-labelledby="ch-book-title">
        <div class="book__head">
          <h2 id="ch-book-title">{T.book}</h2>
          <button class="tbtn" type="button" data-close-book>{T.bookClose}</button>
        </div>
        <p class="progress__text"><strong data-book-count>0</strong> / <span data-book-total>0</span> {T.found} · <span data-book-tokens></span></p>
        <div class="progress__bar"><span data-book-bar></span></div>
        <div class="detail" data-detail hidden></div>
        <div class="families" data-families></div>
      </div>
    </div>
  </div>
</Fun>

<style>
  /* Full window, like Infinite Craft: top bar, optional daily strip, then board + list */
  .ch {
    --common: #9a9a9a;
    --uncommon: #2fbf71;
    --rare: #4d8dff;
    --legendary: #f5b301;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 10px;
    width: 100%;
    max-width: none;
    height: 100dvh;
    padding: 10px;
    overflow: hidden;
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 6px 10px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
  }

  .topbar__fun {
    text-decoration: none;
  }

  .topbar__title {
    font-size: var(--text-xl);
    line-height: 1;
  }

  .topbar .progress {
    flex: 1 1 160px;
    min-width: 140px;
  }

  .topbar__back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 38px;
    padding: 4px 12px;
    background: var(--c-yellow);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .ch {
      padding: 6px;
      gap: 6px;
    }

    .topbar {
      gap: 6px 10px;
    }

    .topbar__title,
    .topbar__backtext,
    .progress__label {
      display: none;
    }

    .topbar .progress {
      order: 5;
      flex-basis: 100%;
    }
  }

  .ch[data-mode='collect'] [data-only='daily'],
  .ch[data-mode='daily'] [data-only='collect'] {
    display: none !important;
  }

  .modes {
    display: inline-flex;
    padding: 3px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
  }

  .mode {
    min-height: 38px;
    padding: 4px 16px;
    background: transparent;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .mode[aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
  }

  .progress {
    display: grid;
    gap: var(--space-1);
  }

  .progress__text {
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .progress__text strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }

  .progress__bar {
    height: 10px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress__bar span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #e50000, #f9bc08, #15b01a, #0343df, #7e1e9c);
    transition: width var(--t-slow) var(--ease-out);
  }

  .tbtn {
    min-height: 40px;
    padding: 6px 14px;
    background: var(--c-yellow);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .tokens {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* ---- daily panel ---- */
  .daily {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    padding: 8px 12px;
    background: var(--c-purple);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
  }

  .daily__intro {
    flex: 1 1 260px;
    max-width: 60ch;
    font-size: var(--text-sm);
  }

  .daily__target {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .daily__swatch {
    flex: none;
    width: 52px;
    aspect-ratio: 1;
    background: var(--c, #ccc);
    border: var(--line) solid var(--ink);
    border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
    box-shadow: var(--shadow-sm);
  }

  .daily__info {
    display: grid;
    gap: 2px;
  }

  .daily__kicker,
  .daily__meta,
  .daily__stats {
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .daily__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.05;
    text-transform: capitalize;
  }

  .match {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .match[hidden],
  .daily__done[hidden] {
    display: none;
  }

  .match__track {
    flex: 1;
    width: 160px;
    max-width: 220px;
    height: 16px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
  }

  .match__track span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--c-green);
    transition: width var(--t-base) var(--ease-out);
  }

  .daily__row {
    max-width: none;
    min-height: 1.4em;
    font-size: 1.3rem;
    letter-spacing: 2px;
    overflow-wrap: anywhere;
  }

  .daily__done {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .daily__solved {
    font-weight: 700;
  }

  /* ---- board + side list ---- */
  .app {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) minmax(0, 40%);
    gap: 10px;
    min-height: 0;
  }

  @media (min-width: 860px) {
    .app {
      grid-template-columns: minmax(0, 1fr) 300px;
      grid-template-rows: minmax(0, 1fr);
    }
  }

  .board {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background:
      radial-gradient(circle, rgb(17 17 17 / 0.13) 1.2px, transparent 1.6px) 0 0 / 22px 22px,
      var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    touch-action: none;
  }

  .board__tools {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tool {
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .tool:hover {
    background: var(--c-yellow);
  }

  .tool[hidden] {
    display: none;
  }

  .ratios {
    display: inline-flex;
    padding: 2px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .ratios[hidden] {
    display: none;
  }

  .ratios button {
    min-height: 34px;
    padding: 2px 12px;
    background: transparent;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 700;
    cursor: pointer;
  }

  .ratios button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
  }

  .board__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    margin: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: rgb(17 17 17 / 0.25);
    text-align: center;
    pointer-events: none;
  }

  .board__empty[hidden] {
    display: none;
  }

  .board__status {
    position: absolute;
    left: 12px;
    bottom: 10px;
    z-index: 3;
    display: grid;
    gap: 4px;
    max-width: calc(100% - 24px);
    pointer-events: none;
  }

  .verdict {
    justify-self: start;
    max-width: 46ch;
    padding: 4px 10px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .verdict:empty {
    display: none;
  }

  .verdict b {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    text-transform: capitalize;
  }

  .thermo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    padding: 4px 10px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .thermo[hidden] {
    display: none;
  }

  .thermo__track {
    position: relative;
    width: 120px;
    height: 10px;
    background: linear-gradient(90deg, #4d8dff, #9b5de5, #ff5a1f, #e50000);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .thermo__track span {
    position: absolute;
    top: -5px;
    left: 0;
    width: 4px;
    height: 16px;
    background: var(--ink);
    border-radius: 2px;
    transition: left var(--t-base) var(--ease-out);
  }

  .board__layer {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* A paint drop on the board: blob plus label, like the pills in Infinite Craft */
  :global(.blob) {
    --c: #ccc;
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 4px;
    transform: translate(-50%, -50%);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  :global(.blob__drop) {
    width: 58px;
    height: 58px;
    background: var(--c);
    border: var(--line) solid var(--ink);
    border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
    box-shadow: var(--shadow-sm);
    transition:
      background 300ms var(--ease-out),
      transform var(--t-fast) var(--ease-pop);
  }

  :global(.blob__label) {
    max-width: 150px;
    padding: 1px 8px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: capitalize;
  }

  :global(.blob--unnamed .blob__label) {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
  }

  :global(.blob:hover .blob__drop),
  :global(.blob.is-dragging .blob__drop) {
    transform: scale(1.08);
  }

  :global(.blob.is-dragging) {
    z-index: 10;
    cursor: grabbing;
  }

  :global(.blob.is-dragging .blob__drop) {
    box-shadow: var(--shadow);
  }

  :global(.blob.is-target .blob__drop) {
    transform: scale(1.2);
    box-shadow:
      0 0 0 4px var(--surface),
      0 0 0 7px var(--ink);
  }

  :global(.blob.is-selected .blob__drop) {
    box-shadow:
      0 0 0 3px var(--surface),
      0 0 0 6px var(--ink);
  }

  :global(.blob:focus-visible) {
    outline: var(--line) dashed var(--ink);
    outline-offset: 4px;
  }

  :global(.blob.is-merged .blob__drop) {
    animation: ch-blob 650ms var(--ease-pop);
  }

  :global(.blob.is-new .blob__label) {
    background: var(--c-yellow);
  }

  :global(.ch-ghost) {
    position: fixed;
    z-index: 200;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  /* One column that scrolls as a whole, on phones and on desktop */
  .side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .side > * {
    flex: none;
  }

  .side__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .side__section {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .side__title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .side__hint {
    max-width: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .search {
    min-height: 36px;
    padding: 4px 10px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .items--found {
    align-content: flex-start;
    padding: 2px;
  }

  /* Side list entries: a small drop and the name, draggable onto the board */
  .items :global(.item) {
    --c: #ccc;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    min-height: 34px;
    padding: 3px 10px 3px 4px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    cursor: grab;
    text-transform: capitalize;
  }

  .items :global(.item i) {
    flex: none;
    width: 22px;
    height: 22px;
    background: var(--c);
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .items :global(.item span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .items :global(.item--hex span) {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
  }

  .items :global(.item--empty) {
    width: 34px;
    padding: 0;
    border-style: dashed;
    border-color: var(--muted);
    cursor: default;
  }

  .items :global(.item--new) {
    background: var(--c-yellow);
  }

  .items :global(.item:hover) {
    background: var(--bg);
  }

  .items :global(.item:focus-visible) {
    outline: 2px dashed var(--ink);
    outline-offset: 2px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    max-width: none;
  }

  .linkish {
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
  }

  /* ---- discovery / unlock card ---- */
  .reveal {
    position: fixed;
    inset: 0;
    z-index: 160;
    display: grid;
    place-items: center;
    padding: var(--space-3);
    background: rgb(17 17 17 / 0.55);
