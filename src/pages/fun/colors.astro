    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: min(100%, 360px);
    padding: var(--space-4);
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
