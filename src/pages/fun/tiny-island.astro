---
/**
 * Tiny Island: shape a little pixel island, put people on it and watch them
 * live (WorldBox-like, our own take). Full-window canvas; the game code lives
 * in src/lib/tiny-island/ (world, sim, agents, ai, animals, path, names,
 * camera, render, ui, main).
 * The world comes from a seed kept in the URL (?seed=…), so a link gives the
 * same island again.
 *
 * Built in phases (plan in the Tiny Island doc). Phase 1: world and camera.
 * Phase 2: people and animals live (needs, utility AI, food, age, wolves).
 * Phase 3: traits, relationships, couples, children, chronicle, profiles.
 * Phase 4: villages (storage, work, houses, leaders, splits, ruins), people perks.
 * Phase 5: mood between peoples, wars, conquest, peace; Rules tab with Aggression.
 * Phase 6: rules for births, lifespan and food, population chart, smoke,
 * confetti and footprints, saving in localStorage, start screen, sharing.
 * Phase 7 (expansion): jobs, fields with crops, ore and tools (jobs.ts).
 * Phase 8: towns and cities, special buildings, walls, town houses (town.ts).
 * Phase 9: inventions with research, effects and god gifts (inventions.ts).
 * Phase 10: weapons and armour, armies and sieges, feuds, alliances, treaties (war.ts).
 * Phase 11: kingdoms with kings, houses, capitals, vassals, revolts, god gifts (kingdoms.ts).
 * Phase 12: art, legends, festivals, god gifts festival and building (culture.ts).
 * Since then: its own look (wood and parchment, Pixelify Sans) and a profile
 * for every place (village-panel.ts), opened by clicking its sign.
 * Update 2, phase A: trees live and die, hunger fixes (hunger.ts), a
 * storyteller (storyteller.ts), causes of death; balance numbers in balance.ts.
 * Phase B: abilities and new traits for everyone, the character editor
 * (editor.ts, characters.ts) with powers and My Characters, Smite.
 * Phase C: family names, memories, revenge and blood feuds, jealousy,
 * separation, mentors, forbidden love, royal weddings and claims (drama.ts).
 * Phase D: leagues and fusion (leagues.ts), plots (plots.ts), god gifts Peace and Ally.
 * Phase E: six ages, nine new inventions, endless progress (inventions.ts).
 * Update 3, phase G: cinema mode (cinema.ts, key K): the interface goes, a
 * director shows the most exciting scenes with bars, a vignette, subtitles,
 * chapter cards and music made in the browser (music.ts).
 * Update 3, phase F: disasters (disasters.ts): lightning, fire, volcanoes,
 * hurricanes, heatwaves, warming and the rising sea; a Disasters window
 * (key D) with the god power Rain, a Rules slider Off/Rare/Normal/Chaos.
 * Update 3, phase E: the need for culture and the mood (society.ts),
 * philosophers, musicians, fools and actors, books and plays, culture levels
 * (stars on the signs).
 * Update 3, phase D: prophets and religions (religion.ts), priests and
 * missionaries, pilgrims, splits, state religions, holy wars; a Religions
 * tab with a faith map.
 * Update 3, phase B: every tile belongs to a place (territory.ts), tinted
 * land with borders (key G), claims and land grabs, wars for land; the
 * World window has a Territory tab.
 * Update 3, phase A: no nights (short naps instead of sleep), berry bushes
 * only at forest edges, at most 3 % of the grass, each living 10–20 years.
 * UI update: a bar at the bottom like in sandbox games (Build, Rules, World,
 * Chronicle). Each opens its own window: Build (Shape, Life, Characters) and
 * Rules (sliders only) sit over the bar, World (peoples, kingdoms, leagues,
 * wonders, inventions, culture, population) is a big window with tabs, the
 * chronicle stays a small window on the right.
 */
import Fun from '@/layouts/Fun.astro';
import '@fontsource-variable/pixelify-sans';
import { UI } from '@/data/ui';
import { GREY_HAIR, HAIR_STYLES, HAIRS, HATS, PEOPLE_COLORS, PEOPLES, PLAYABLE, POWERS, SKINS, STATS, TRAITS } from '@/lib/tiny-island/agents';
import { JOBS } from '@/lib/tiny-island/jobs';
import { COLORS } from '@/lib/tiny-island/render';
import { TERRAIN_KEYS } from '@/lib/tiny-island/world';
import { SITE } from '@/data/site';
import og from '@/assets/fun/tiny-island-og.png';

const ogImage = new URL(og.src, SITE.fun.url).href;

const T = UI.fun.tinyIsland;
const strings = {
  year: T.year,
  age: T.age,
  peoples: T.peoples,
  life: T.life,
  doing: T.doing,
  traits: T.traits,
  chronicle: T.chronicle,
  profile: T.profile,
  ruins: T.ruins,
  rules: T.rules,
  start: T.start,
  statsEmpty: T.statsEmpty,
  jobs: T.jobs,
  villageTip: T.villageTip,
  tiers: T.tiers,
  buildings: T.buildings,
  inventions: T.inventions,
  weapons: T.weapons,
  armor: T.armor,
  kingdoms: T.kingdoms,
  culture: T.culture,
  village: T.village,
  leagues: T.leagues,
  ages: T.ages,
  wonders: T.wonders,
  armies: T.armies,
  deaths: T.deaths,
  stats: T.stats,
  powers: T.powers,
  editor: T.editor,
  territory: T.territory,
  religion: T.religion,
  building: T.building,
  disasters: T.disasters,
  cinema: T.cinema,
  borders: T.bar.borderModes,
};
const E = T.editor;
const hairColors = [...HAIRS, GREY_HAIR, '#f4f1e8', '#e86fa3'];
const clothColors = ['', '#e8344a', '#ff8a1e', '#ffd23f', '#3ddc84', '#3b7ddd', '#7a4fd1', '#ff5da2', '#f4f1e8', '#3a3a3a'];
const rules = [
  { key: 'aggression', name: T.rules.aggression, low: T.rules.calm, high: T.rules.fierce, min: 0, max: 2 },
  { key: 'birth', name: T.rules.birth, low: T.rules.birthLow, high: T.rules.birthHigh, min: 0.3, max: 2 },
  { key: 'lifespan', name: T.rules.lifespan, low: T.rules.lifespanLow, high: T.rules.lifespanHigh, min: 0.6, max: 1.4 },
  { key: 'food', name: T.rules.food, low: T.rules.foodLow, high: T.rules.foodHigh, min: 0.4, max: 2 },
  { key: 'disasters', name: T.rules.disasters, low: T.rules.disasterWords[0], high: T.rules.disasterWords[3], min: 0, max: 3, step: 1, value: 2, words: T.rules.disasterWords },
] as { key: string; name: string; low: string; high: string; min: number; max: number; step?: number; value?: number; words?: readonly string[] }[];
const lifeTools = [
  { key: 'sheep', icon: '🐑' },
  { key: 'chicken', icon: '🐔' },
  { key: 'wolf', icon: '🐺' },
  { key: 'horse', icon: '🐎' },
  { key: 'cow', icon: '🐄' },
] as const;
const swatch: Record<(typeof TERRAIN_KEYS)[number], string> = {
  deep: COLORS.deep,
  shallow: COLORS.shallow,
  sand: COLORS.sand,
  grass: COLORS.grass,
  forest: COLORS.leaf,
  mountain: COLORS.rock,
};
const worldTabs = [
  { key: 'peoples', icon: '🤝', name: T.rules.relations },
  { key: 'territory', icon: '🚩', name: T.territory.title },
  { key: 'kingdoms', icon: '👑', name: T.kingdoms.title },
  { key: 'leagues', icon: '🛡️', name: T.leagues.title },
  { key: 'wonders', icon: '🏛️', name: T.bar.wonders },
  { key: 'inventions', icon: '💡', name: T.rules.inventions },
  { key: 'culture', icon: '🎨', name: T.culture.title },
  { key: 'religions', icon: '✨', name: T.religion.title },
  { key: 'population', icon: '📊', name: T.statsTitle },
] as const;
const B = T.bar;
const disasterTools = [
  { key: 'lightning', icon: '⚡' },
  { key: 'volcano', icon: '🌋' },
  { key: 'hurricane', icon: '🌀' },
  { key: 'rain', icon: '🌧️' },
] as const;
const speeds = [
  { value: 0, label: '❚❚', aria: T.pause },
  { value: 1, label: '1×', aria: '1×' },
  { value: 3, label: '3×', aria: '3×' },
  { value: 10, label: '10×', aria: '10×' },
];
---

<Fun title={T.title} description={T.description} path="/tiny-island" indexHref="./" image={ogImage} bare>
  <div class="ti" data-tiny-island data-strings={JSON.stringify(strings)}>
    <canvas class="ti__map" data-canvas role="img" aria-label={T.canvasLabel}></canvas>

    <header class="ti__top">
      <a class="ti__fun" href="./" aria-label={UI.fun.indexTitle}>◂ {UI.fun.title}</a>
      <h1 class="ti__title">{T.title}</h1>
      <p class="ti__seed" title={T.world}><span class="ti__seed-label">{T.world}</span> <span data-seed></span></p>
      <button type="button" class="ti__btn ti__share" data-share>🔗 {T.start.share}</button>
      <span class="ti__saved" data-saved aria-live="polite"></span>
      <div class="ti__clock">
        <span class="ti__daynight" aria-hidden="true">
          <svg class="ti__sun" viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="5"></circle><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path></svg
          >
        </span>
        <span class="ti__year" data-year>{T.year.replace('{n}', '1')}</span>
      </div>
      <p class="ti__pop" aria-label={T.population}>
        <span title={T.life.human}>👤 <b data-pop="human">0</b></span>
        <span title={T.life.sheep}>🐑 <b data-pop="sheep">0</b></span>
        <span title={T.life.chicken}>🐔 <b data-pop="chicken">0</b></span>
        <span title={T.life.wolf}>🐺 <b data-pop="wolf">0</b></span>
        <span title={T.life.horse}>🐎 <b data-pop="horse">0</b></span>
        <span title={T.life.cow}>🐄 <b data-pop="cow">0</b></span>
        <span title={T.villages}>🏘️ <b data-pop="villages">0</b></span>
      </p>
      <div class="ti__speed" role="group" aria-label={T.speedLabel}>
        {
          speeds.map((s) => (
            <button type="button" class="ti__btn" data-speed={s.value} aria-label={s.aria} aria-pressed={s.value === 1 ? 'true' : 'false'}>
              {s.label}
            </button>
          ))
        }
      </div>
    </header>

    <div class="ti__dock">
      <section class="ti__win ti__win--build" id="ti-win-build" data-win="build" data-tabset aria-label={B.build} hidden>
        <header class="ti__win-head">
          <div class="ti__tabs" role="tablist" aria-label={B.build}>
            <button type="button" class="ti__tab" role="tab" data-tab="shape" aria-selected="true">🏔️ {T.tabs.shape}</button>
            <button type="button" class="ti__tab" role="tab" data-tab="life" aria-selected="false">🐑 {T.tabs.life}</button>
            <button type="button" class="ti__tab" role="tab" data-tab="characters" aria-selected="false">✦ {T.tabs.characters}</button>
          </div>
          <button type="button" class="ti__win-close" data-win-close aria-label={B.close} title={B.close}>×</button>
        </header>
        <div class="ti__panel" data-panel="shape" role="tabpanel">
          <div class="ti__tools" role="group" aria-label={T.tabs.shape}>
            <button type="button" class="ti__tool" data-tool="move" aria-pressed="true" title={T.tools.move}>
              <svg class="ti__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3M2 12l3-3M2 12l3 3M22 12l-3-3M22 12l-3 3"></path></svg>
              <span>{T.tools.move}</span>
            </button>
            {
              TERRAIN_KEYS.map((k) => (
                <button type="button" class="ti__tool" data-tool={k} aria-pressed="false" title={T.tools[k]}>
                  <span class="ti__swatch" style={`--sw: ${swatch[k]}`} data-kind={k} aria-hidden="true" />
                  <span>{T.tools[k]}</span>
                </button>
              ))
            }
          </div>
          <div class="ti__sizes" role="group" aria-label={T.brushLabel}>
            {
              (['s', 'm', 'l'] as const).map((s) => (
                <button type="button" class="ti__btn" data-size={s} aria-pressed={s === 'm' ? 'true' : 'false'} aria-label={`${T.brushLabel} ${T.sizes[s]}`}>
                  {T.sizes[s]}
                </button>
              ))
            }
          </div>
          <button type="button" class="ti__random" data-random>🎲 {T.random}</button>
        </div>
        <div class="ti__panel" data-panel="life" role="tabpanel" hidden>
          <div class="ti__tools" role="group" aria-label={T.tabs.life}>
            <button type="button" class="ti__tool" data-tool="move" aria-pressed="true" title={T.tools.move}>
              <svg class="ti__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3M2 12l3-3M2 12l3 3M22 12l-3-3M22 12l-3 3"></path></svg>
              <span>{T.tools.move}</span>
            </button>
            <button type="button" class="ti__tool" data-tool="human" aria-pressed="false" title={T.life.human}>
              <span class="ti__emoji" aria-hidden="true">👤</span>
              <span>{T.life.human}</span>
            </button>
            {
              lifeTools.map((l) => (
                <button type="button" class="ti__tool" data-tool={l.key} aria-pressed="false" title={T.life[l.key]}>
                  <span class="ti__emoji" aria-hidden="true">{l.icon}</span>
                  <span>{T.life[l.key]}</span>
                </button>
              ))
            }
          </div>
          <p class="ti__note">{T.lifeHint}</p>
        </div>
        <div class="ti__panel ti__panel--chars" data-panel="characters" role="tabpanel" hidden>
          <p class="ti__note">{E.intro}</p>
          <button type="button" class="ti__create" data-editor-open>{E.create}</button>
          <div class="ti__mine">
            <span class="ti__rule-name">{E.mine}</span>
            <div class="ti__mine-list" data-mine-list></div>
          </div>
          <p class="ti__place-hint" data-place-hint hidden></p>
        </div>
      </section>

      <section class="ti__win ti__win--rules" id="ti-win-rules" data-win="rules" aria-labelledby="ti-rules-title" hidden>
        <header class="ti__win-head">
          <h2 class="ti__win-title" id="ti-rules-title">⚖️ {B.rules}</h2>
          <button type="button" class="ti__win-close" data-win-close aria-label={B.close} title={B.close}>×</button>
        </header>
        <p class="ti__note">{T.rules.intro}</p>
        {
          rules.map((r) => (
            <label class="ti__rule">
              <span class="ti__rule-name">
                {r.name}
                {r.words && (
                  <output class="ti__rule-out" data-rule-out={r.key}>
                    {r.words[r.value ?? 0]}
                  </output>
                )}
              </span>
              <span class="ti__rule-end">{r.low}</span>
              <input type="range" min={r.min} max={r.max} step={r.step ?? 0.1} value={r.value ?? 1} data-rule={r.key} data-words={r.words ? JSON.stringify(r.words) : undefined} />
              <span class="ti__rule-end">{r.high}</span>
            </label>
          ))
        }
        <p class="ti__note">{T.rules.aggressionHint}</p>
        <p class="ti__rule-name ti__rule-head">🎬 {T.cinema.settings}</p>
        <label class="ti__check"><input type="checkbox" data-music /> {T.cinema.music}</label>
        <label class="ti__rule ti__rule--volume">
          <span class="ti__rule-name">{T.cinema.volume}</span>
          <span class="ti__rule-end">–</span>
          <input type="range" min="0" max="1" step="0.05" value="0.5" data-volume />
          <span class="ti__rule-end">+</span>
        </label>
        <label class="ti__check"><input type="checkbox" data-cine-clean /> {T.cinema.clean}</label>
      </section>

      <section class="ti__win ti__win--rules" id="ti-win-disasters" data-win="disasters" aria-labelledby="ti-dis-title" hidden>
        <header class="ti__win-head">
          <h2 class="ti__win-title" id="ti-dis-title">🌋 {B.disasters}</h2>
          <button type="button" class="ti__win-close" data-win-close aria-label={B.close} title={B.close}>×</button>
        </header>
        <p class="ti__note">{T.disasters.note}</p>
        <div class="ti__tools" role="group" aria-label={B.disasters}>
          {
            disasterTools.map((d) => (
              <button type="button" class="ti__tool" data-tool={d.key} aria-pressed="false" title={T.disasters.tools[d.key]}>
                <span class="ti__emoji" aria-hidden="true">{d.icon}</span>
                <span>{T.disasters.tools[d.key]}</span>
              </button>
            ))
          }
          <button type="button" class="ti__tool" data-heatwave title={T.disasters.heatwaveTitle}>
            <span class="ti__emoji" aria-hidden="true">🔥</span>
            <span>{T.disasters.heatwave}</span>
          </button>
        </div>
        <p class="ti__note ti__dis-hint" data-disaster-hint aria-live="polite"></p>
      </section>

      <nav class="ti__bar" aria-label={B.label}>
        <button type="button" class="ti__bar-btn" data-win-open="build" aria-expanded="false" aria-controls="ti-win-build" title={`${B.buildHint} (B)`}>
          <span class="ti__bar-icon" aria-hidden="true">🛠️</span><span class="ti__bar-name">{B.build}</span>
        </button>
        <button type="button" class="ti__bar-btn" data-win-open="rules" aria-expanded="false" aria-controls="ti-win-rules" title={`${B.rulesHint} (R)`}>
          <span class="ti__bar-icon" aria-hidden="true">⚖️</span><span class="ti__bar-name">{B.rules}</span>
        </button>
        <button type="button" class="ti__bar-btn" data-win-open="world" aria-expanded="false" aria-controls="ti-win-world" title={`${B.worldHint} (W)`}>
          <span class="ti__bar-icon" aria-hidden="true">🌍</span><span class="ti__bar-name">{B.world}</span>
        </button>
        <button type="button" class="ti__bar-btn" data-win-open="disasters" aria-expanded="false" aria-controls="ti-win-disasters" title={`${B.disastersHint} (D)`}>
          <span class="ti__bar-icon" aria-hidden="true">🌋</span><span class="ti__bar-name">{B.disasters}</span>
        </button>
        <span class="ti__bar-sep" aria-hidden="true"></span>
        <button type="button" class="ti__bar-btn" data-chron-toggle aria-expanded="false" aria-controls="ti-chronicle" title={`${T.chronicle.toggle} (C)`}>
          <span class="ti__bar-icon" aria-hidden="true">📜</span><span class="ti__bar-name">{T.chronicle.title}</span>
        </button>
        <button type="button" class="ti__bar-btn" data-cinema title={`${B.cinemaHint} (K)`}>
          <span class="ti__bar-icon" aria-hidden="true">🎬</span><span class="ti__bar-name">{B.cinema}</span>
        </button>
        <button type="button" class="ti__bar-btn ti__bar-btn--small" data-borders aria-pressed="true" title={`${T.bar.borderModes.normal} (G)`}>
          <span class="ti__bar-icon" aria-hidden="true">🚩</span><span class="ti__bar-name" data-borders-name>{T.bar.borderModes.normal}</span>
        </button>
        <button type="button" class="ti__current" data-drop-tool title={B.drop} hidden>
          <span class="ti__current-name" data-current></span><span aria-hidden="true">✕</span>
        </button>
      </nav>
    </div>

    <section class="ti__win ti__win--world" id="ti-win-world" data-win="world" data-tabset aria-labelledby="ti-world-title" hidden>
      <header class="ti__win-head">
        <h2 class="ti__win-title" id="ti-world-title">🌍 {B.world}</h2>
        <button type="button" class="ti__win-close" data-win-close aria-label={B.close} title={B.close}>×</button>
      </header>
      <div class="ti__tabs ti__wtabs" role="tablist" aria-label={B.world}>
        {
          worldTabs.map((w, i) => (
            <button type="button" class="ti__tab" role="tab" data-tab={w.key} aria-selected={i === 0 ? 'true' : 'false'}>
              <span aria-hidden="true">{w.icon}</span> {w.name}
            </button>
          ))
        }
      </div>
      <div class="ti__wbody">
        <div class="ti__wpanel" data-panel="peoples" role="tabpanel">
          <p class="ti__note">{T.worldNotes.peoples}</p>
          <ul class="ti__rel-list" data-relations></ul>
        </div>
        <div class="ti__wpanel" data-panel="territory" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.territory}</p>
          <ul class="ti__rel-list ti__terr-list" data-territory></ul>
        </div>
        <div class="ti__wpanel" data-panel="kingdoms" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.kingdoms}</p>
          <ul class="ti__rel-list ti__king-list" data-kingdoms></ul>
        </div>
        <div class="ti__wpanel" data-panel="leagues" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.leagues}</p>
          <ul class="ti__rel-list ti__league-list" data-leagues></ul>
        </div>
        <div class="ti__wpanel" data-panel="wonders" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.wonders}</p>
          <ul class="ti__rel-list ti__wonder-list" data-wonders></ul>
        </div>
        <div class="ti__wpanel" data-panel="inventions" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.inventions}</p>
          <ul class="ti__rel-list ti__tech-list" data-tech></ul>
        </div>
        <div class="ti__wpanel" data-panel="culture" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.culture}</p>
          <ul class="ti__rel-list ti__tech-list ti__culture-list" data-culture></ul>
        </div>
        <div class="ti__wpanel" data-panel="religions" role="tabpanel" hidden>
          <p class="ti__note">{T.worldNotes.religions}</p>
          <button type="button" class="ti__btn ti__faith-map" data-faith-map aria-pressed="false">🗺️ {T.religion.map}</button>
          <ul class="ti__rel-list ti__faith-list" data-religions></ul>
        </div>
        <div class="ti__wpanel ti__wpanel--pop" data-panel="population" role="tabpanel" hidden>
          <div class="ti__pop-chart">
            <h3 class="ti__chron-title">📈 {T.statsTitle}</h3>
            <p class="ti__legend" aria-hidden="true">
              {
                PEOPLES.map((k) => (
                  <span data-legend={k}>
                    <svg width="18" height="6" viewBox="0 0 18 6">
                      <line x1="1" y1="3" x2="17" y2="3" stroke={PEOPLE_COLORS[k].cloth} stroke-width="2" stroke-dasharray={k === 'forest' ? '6 3' : k === 'mountain' ? '2 3' : k === 'steppe' ? '9 3 2 3' : k === 'islanders' ? '1 2' : undefined} />
                    </svg>
                    {T.peoples[k]}
                  </span>
                ))
              }
            </p>
            <div class="ti__stats" data-stats></div>
            <p class="ti__stats-tip" data-stats-tip hidden></p>
          </div>
          <div class="ti__pop-deaths">
            <h3 class="ti__chron-title">🪦 {T.deaths.title}</h3>
            <ul class="ti__deaths" data-deaths></ul>
            <div class="ti__temp" data-temp></div>
          </div>
        </div>
      </div>
    </section>

    <div class="ti__cinema" data-cinema-view hidden>
      <div class="ti__cine-vignette"></div>
      <div class="ti__cine-bar ti__cine-bar--top"></div>
      <div class="ti__cine-bar ti__cine-bar--bottom"><p class="ti__cine-sub" data-cine-sub aria-live="polite"></p></div>
      <p class="ti__cine-chapter" data-cine-chapter hidden></p>
      <p class="ti__cine-ff" data-cine-ff hidden></p>
      <p class="ti__cine-exit">{T.cinema.exit}</p>
    </div>
    <aside class="ti__profile" data-profile hidden aria-live="polite"></aside>
    <aside class="ti__chron" id="ti-chronicle" data-chron aria-labelledby="ti-chron-title" hidden>
      <header class="ti__win-head">
        <h2 class="ti__chron-title" id="ti-chron-title">📜 {T.chronicle.title}</h2>
        <button type="button" class="ti__win-close" data-chron-toggle aria-label={B.close} title={B.close}>×</button>
      </header>
      <ol class="ti__chron-list" data-chron-list></ol>
    </aside>
    <p class="ti__hint">{T.hint}</p>
    <div class="ti__start" data-start>
      <div class="ti__start-card">
        <p class="ti__start-kicker" aria-hidden="true">🏝️</p>
        <h2 class="ti__start-title">{T.title}</h2>
        <p class="ti__start-tag">{T.tagline}</p>
        <div class="ti__start-btns">
          <button type="button" class="ti__start-btn ti__start-btn--main" data-start-continue hidden>
            ▶ {T.start.continue}<small data-start-info></small>
          </button>
          <button type="button" class="ti__start-btn ti__start-btn--main" data-start-shared hidden>
            🔗 {T.start.playShared}<small data-start-shared-seed></small>
          </button>
          <button type="button" class="ti__start-btn" data-start-random>🎲 {T.start.random}<small>{T.start.randomInfo}</small></button>
          <button type="button" class="ti__start-btn" data-start-empty>🏝️ {T.start.empty}<small>{T.start.emptyInfo}</small></button>
        </div>
        <p class="ti__start-note">{T.start.saveNote}</p>
      </div>
    </div>
    <div class="ti__editor" data-editor hidden role="dialog" aria-modal="true" aria-labelledby="ti-editor-title">
      <div class="ti__editor-card">
        <header class="ti__editor-head">
          <h2 id="ti-editor-title">✦ {E.title}</h2>
          <button type="button" class="ti__editor-close" data-e="close" aria-label={E.close}>×</button>
        </header>
        <div class="ti__editor-body">
          <div class="ti__editor-preview">
            <canvas width="108" height="132" data-editor-preview role="img" aria-label={E.preview}></canvas>
            <button type="button" class="ti-e__btn" data-e="random">{E.random}</button>
          </div>
          <div class="ti__editor-form">
            <label class="ti-e__row">
              <span class="ti-e__label">{E.name}</span>
              <input type="text" maxlength="20" class="ti-e__text" data-e-name placeholder={E.namePlaceholder} />
            </label>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.sex}</span>
              <div class="ti-e__opts">
                <button type="button" class="ti-e__opt" data-e="female:1">{E.female}</button>
                <button type="button" class="ti-e__opt" data-e="female:0">{E.male}</button>
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.age}</span>
              <div class="ti-e__opts">
                {(['child', 'adult', 'old'] as const).map((k) => <button type="button" class="ti-e__opt" data-e={`age:${k}`}>{E.ageButtons[k]}</button>)}
                <input type="range" min="0" max="90" class="ti-e__range" data-e-age aria-label={E.age} />
                <output class="ti-e__out" data-e-age-text></output>
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.people}</span>
              <div class="ti-e__opts">
                {
                  PLAYABLE.map((k) => (
                    <button type="button" class="ti-e__opt" data-e={`people:${k}`}>
                      <span class="ti__swatch" style={`--sw: ${PEOPLE_COLORS[k].cloth}`} aria-hidden="true" />
                      {T.peoples[k]}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.likes}</span>
              <div class="ti-e__opts">
                {(['women', 'men', 'both'] as const).map((k) => <button type="button" class="ti-e__opt" data-e={`likes:${k}`}>{E.likesKinds[k]}</button>)}
              </div>
            </div>
            <h3 class="ti-e__h">{E.looks}</h3>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.skin}</span>
              <div class="ti-e__opts">
                {SKINS.map((c) => <button type="button" class="ti-e__swatch" data-e={`skin:${c}`} style={`--sw: ${c}`} aria-label={`${E.skin} ${c}`} />)}
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.hair}</span>
              <div class="ti-e__opts">
                {hairColors.map((c) => <button type="button" class="ti-e__swatch" data-e={`hair:${c}`} style={`--sw: ${c}`} aria-label={`${E.hair} ${c}`} />)}
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.style}</span>
              <div class="ti-e__opts">
                {HAIR_STYLES.map((k) => <button type="button" class="ti-e__opt" data-e={`style:${k}`}>{E.styles[k]}</button>)}
                <label class="ti-e__check"><input type="checkbox" data-e-beard /> {E.beard}</label>
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.hat}</span>
              <div class="ti-e__opts">
                {HATS.map((k) => <button type="button" class="ti-e__opt" data-e={`hat:${k}`}>{E.hats[k]}</button>)}
              </div>
            </div>
            <div class="ti-e__row">
              <span class="ti-e__label">{E.cloth}</span>
              <div class="ti-e__opts">
                {
                  clothColors.map((c) =>
                    c ? (
                      <button type="button" class="ti-e__swatch" data-e={`cloth:${c}`} style={`--sw: ${c}`} aria-label={`${E.cloth} ${c}`} />
                    ) : (
                      <button type="button" class="ti-e__opt" data-e="cloth:">{E.clothPeople}</button>
                    ),
                  )
                }
              </div>
            </div>
            <h3 class="ti-e__h">{E.abilities}</h3>
            {
              STATS.map((s) => (
                <label class="ti-e__row ti-e__stat">
                  <span class="ti-e__label">{T.stats[s]}</span>
                  <input type="range" min="1" max="10" class="ti-e__range" data-e-stat={s} />
                  <output class="ti-e__out" data-e-stat-out={s}></output>
                </label>
              ))
            }
            <h3 class="ti-e__h">{E.traits}</h3>
            <p class="ti-e__hint">{E.traitsHint}</p>
            <div class="ti-e__chips">
              {TRAITS.map((k) => <button type="button" class="ti-e__chip" data-e={`trait:${k}`}>{T.traits[k]}</button>)}
            </div>
            <label class="ti-e__row">
              <span class="ti-e__label">{E.job}</span>
              <select class="ti-e__select" data-e-job>
                <option value="auto">{E.jobAuto}</option>
                {JOBS.map((j) => <option value={j}>{T.jobs[j]}</option>)}
              </select>
            </label>
            <h3 class="ti-e__h">{E.powers}</h3>
            <div class="ti-e__chips">
              {
                POWERS.map((k) => (
                  <button type="button" class="ti-e__chip ti-e__power" data-e={`power:${k}`} title={T.powers[k].does}>
                    {T.powers[k].name}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
        <footer class="ti__editor-foot">
          <button type="button" class="ti-e__btn" data-e="close">{E.cancel}</button>
          <button type="button" class="ti-e__btn ti-e__btn--main" data-e="place">{E.place}</button>
        </footer>
      </div>
    </div>
    <p class="ti__tip" data-tip hidden></p>
    <noscript><p class="ti__nojs">{T.noJs}</p></noscript>
  </div>
</Fun>

<style>
  .ti {
    /*
     * Tiny Island has its own look, not the site's: wood and parchment like an
     * old storybook, Pixelify Sans for titles, buttons and numbers, a book face
     * for longer text. The site tokens are mapped onto it here, so every rule
     * below that uses --ink, --surface … gets the island colours.
     */
    --ti-parch: #f3e6c4;
    --ti-parch-light: #fbf3dc;
    --ti-parch-dark: #e6d3a3;
    --ti-wood: #8a5a2e;
    --ti-wood-light: #b07a45;
    --ti-wood-dark: #4e2d14;
    --ti-ink: #3b2a1a;
    --ti-muted: #7a6249;
    --ti-gold: #d9a531;
    --ti-gold-light: #f2cf6b;
    --ti-red: #a8322a;
    --ti-green: #6f9a3e;
    --ti-pixel: 'Pixelify Sans Variable', system-ui, sans-serif;
    --ti-book: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --ink: var(--ti-ink);
    --muted: var(--ti-muted);
    --bg: var(--ti-parch-light);
    --surface: var(--ti-parch);
    --c-yellow: var(--ti-gold-light);
    --c-green: #a9cf74;
    --font-display: var(--ti-pixel);
    --font-mono: var(--ti-pixel);
    --font-body: var(--ti-book);
    --line: 4px;
    --radius: 4px;
    --radius-lg: 6px;
    --shadow-sm: 0 2px 0 var(--ti-wood-dark);
    --shadow: 0 0 0 2px var(--ti-wood-dark), 0 6px 14px rgb(30 15 5 / 0.35);
    --shadow-lg: 0 0 0 2px var(--ti-wood-dark), 0 12px 30px rgb(30 15 5 / 0.45);

    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #2c5fbf;
    color: var(--ti-ink);
    font-family: var(--ti-book);
    user-select: none;
  }

  .ti.is-pointing .ti__map {
    cursor: pointer;
  }

  /* The site keeps paragraphs and list items to a reading measure; the game panels are not prose */
  .ti :global(p),
  .ti :global(li) {
    max-width: none;
  }

  .ti__map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .ti[data-tool]:not([data-tool='move']) .ti__map {
    cursor: crosshair;
  }

  .ti.is-panning .ti__map {
    cursor: grabbing;
  }

  /* ---- top bar ---- */
  .ti__top {
    position: absolute;
    top: 10px;
    right: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 6px 10px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    pointer-events: auto;
  }

  .ti__fun {
    padding: 3px 8px;
    color: #fbefd2;
    background: linear-gradient(180deg, var(--ti-wood-light), var(--ti-wood));
    border: 2px solid var(--ti-wood-dark);
    border-radius: 3px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 2px 0 var(--ti-wood-dark);
    font-family: var(--ti-pixel);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    text-shadow: 0 1px 0 rgb(40 20 5 / 0.5);
  }

  .ti__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1;
  }

  .ti__seed {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .ti__seed-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ti__clock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .ti__daynight svg {
    display: block;
    width: 22px;
    height: 22px;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ti__sun circle {
    fill: var(--c-yellow);
  }


  .ti__speed,
  .ti__sizes {
    display: inline-flex;
    gap: 4px;
  }

  .ti__btn {
    min-width: 40px;
    min-height: 36px;
    padding: 4px 8px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .ti__btn[aria-pressed='true'] {
    background: var(--c-yellow);
    box-shadow: var(--shadow-sm);
  }

  /* ---- bottom: windows over a bar (like the build menus of sandbox games) ---- */
  .ti__dock {
    position: absolute;
    bottom: max(10px, env(safe-area-inset-bottom));
    left: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: min(calc(100% - 20px), 860px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ti__dock > * {
    pointer-events: auto;
  }

  .ti__bar {
    display: flex;
    align-items: stretch;
    gap: 6px;
    padding: 6px;
  }

  .ti__bar-btn {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-width: 72px;
    padding: 5px 8px 4px;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .ti__bar-btn:hover {
    transform: translateY(-2px);
  }

  .ti__bar-icon {
    font-size: 22px;
    line-height: 1;
  }

  .ti__bar-name {
    font-size: 13px;
    line-height: 1.1;
  }

  .ti__bar-sep {
    width: 2px;
    margin: 4px 2px;
    background: var(--ti-wood);
    border-radius: 1px;
  }

  /* The brush in hand while the Build window is closed: click to put it away */
  .ti__current {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: center;
    max-width: 180px;
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
  }

  .ti__current[hidden] {
    display: none;
  }

  .ti__current-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ti__win {
    display: grid;
    gap: 8px;
    width: 100%;
    padding: 8px 10px 10px;
  }

  .ti__win[hidden] {
    display: none;
  }

  .ti__win--rules {
    width: min(100%, 520px);
  }

  .ti__win-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .ti__win-title {
    margin: 0;
    font-size: var(--text-base);
  }

  .ti__win-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  /* The World window: big, between the top bar and the bottom bar */
  .ti__win--world {
    position: absolute;
    top: var(--top, 78px);
    bottom: var(--dock, 90px);
    left: 50%;
    z-index: 3;
    grid-template-rows: auto auto minmax(0, 1fr);
    width: min(calc(100% - 20px), 920px);
    max-height: 560px;
    margin: auto 0;
    transform: translateX(-50%);
  }

  .ti__wtabs {
    flex-wrap: wrap;
  }

  .ti__wtabs {
    gap: 3px;
  }

  .ti__wtabs .ti__tab {
    padding: 4px 6px;
    font-size: 11px;
  }

  /* Rules: names, ends and sliders in straight columns */
  .ti__win--rules .ti__rule {
    display: grid;
    grid-template-columns: 96px 58px minmax(0, 1fr) 58px;
  }

  .ti__win--rules .ti__rule-name + .ti__rule-end {
    text-align: right;
  }

  @media (max-width: 640px) {
    .ti__win--rules .ti__rule {
      grid-template-columns: 58px minmax(0, 1fr) 58px;
    }

    .ti__win--rules .ti__rule .ti__rule-name {
      grid-column: 1 / -1;
    }
  }

  .ti__wbody {
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
    scrollbar-color: var(--ti-wood) var(--ti-parch-dark);
    scrollbar-width: thin;
  }

  .ti__wpanel[hidden] {
    display: none;
  }

  .ti__wpanel > .ti__note {
    margin-bottom: 6px;
  }

  .ti__wpanel--pop {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 16px;
  }

  @media (max-width: 700px) {
    .ti__wpanel--pop {
      grid-template-columns: 1fr;
    }
  }

  /* The Borders button: three states (G) */
  .ti__bar-btn--small {
    min-width: 64px;
  }

  .ti__bar-btn[data-borders][data-mode='strong'] {
    color: var(--ti-ink);
    background: linear-gradient(180deg, var(--ti-gold-light), var(--ti-gold));
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.4);
  }

  .ti__bar-btn[data-borders][data-mode='off'] {
    opacity: 0.6;
  }

  /* Narrow phones: the bar shows its icons only (the names stay as tooltips) */
  @media (max-width: 420px) {
    .ti__bar-name {
      display: none;
    }

    .ti__bar-btn {
      min-width: 40px;
      padding: 6px 4px;
    }

    .ti__bar-icon {
      font-size: 20px;
    }
  }

  /* Cinema mode (Update 3): only the island, bars, a vignette, subtitles */
  .ti.is-cinema .ti__top,
  .ti.is-cinema .ti__dock,
  .ti.is-cinema .ti__win--world,
  .ti.is-cinema .ti__chron,
  .ti.is-cinema .ti__profile,
  .ti.is-cinema .ti__hint {
    display: none !important;
  }

  .ti__cinema {
    position: absolute;
    inset: 0;
    z-index: 6;
    cursor: pointer;
  }

  .ti__cinema[hidden] {
    display: none;
  }

  .ti__cine-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.45) 100%);
    pointer-events: none;
  }

  .ti__cine-bar {
    position: absolute;
    right: 0;
    left: 0;
    height: 11vh;
    background: #000;
  }

  .ti__cine-bar--top {
    top: 0;
  }

  .ti__cine-bar--bottom {
    bottom: 0;
    display: grid;
    place-items: center;
    padding: 0 6vw;
  }

  .ti__cine-sub {
    margin: 0;
    color: #f4efe2;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(14px, 2.2vw, 22px);
    font-style: italic;
    text-align: center;
    text-shadow: 0 1px 2px #000;
    animation: cine-in 900ms ease-out;
  }

  .ti__cine-chapter {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    padding: 14px 28px;
    color: #f4efe2;
    background: rgb(0 0 0 / 0.55);
    font-family: var(--ti-pixel);
    font-size: clamp(18px, 3.4vw, 34px);
    letter-spacing: 0.06em;
    transform: translate(-50%, -50%);
    animation: cine-in 1200ms ease-out;
  }

  .ti__cine-chapter[hidden],
  .ti__cine-ff[hidden] {
    display: none;
  }

  /* Time-lapse: the years fly by */
  .ti__cine-ff {
    position: absolute;
    top: calc(11vh + 8px);
    left: 12px;
    margin: 0;
    color: rgb(255 255 255 / 0.85);
    font-family: var(--ti-pixel);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-shadow: 0 1px 2px #000;
  }

  .ti__cine-exit {
    position: absolute;
    top: calc(11vh + 8px);
    right: 12px;
    margin: 0;
    color: rgb(255 255 255 / 0.6);
    font-size: 11px;
    text-shadow: 0 1px 2px #000;
  }

  .ti__cinema.is-clean .ti__cine-bar,
  .ti__cinema.is-clean .ti__cine-exit {
    display: none;
  }

  @keyframes cine-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ti__cine-sub,
    .ti__cine-chapter {
      animation: none;
    }
  }

  .ti__rule-head {
    margin-top: 6px;
  }

  .ti__check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .ti__check input {
    accent-color: var(--ti-wood);
  }

  /* Disasters (Update 3) */
  .ti__rule-out {
    margin-left: 6px;
    font-family: var(--ti-pixel);
    color: #c0392b;
  }

  .ti__dis-hint:empty {
    display: none;
  }

  .ti__temp {
    margin-top: 10px;
    font-size: 12px;
  }

  .ti__temp :global(.ti-temp__line) {
    margin: 0 0 2px;
  }

  .ti__temp :global(.ti-temp__svg) {
    display: block;
    width: 100%;
    height: 44px;
    margin-top: 4px;
    background: rgb(232 52 74 / 0.06);
    border: 1px solid var(--ti-wood);
    border-radius: 2px;
  }

  /* Religions tab (Update 3) */
  .ti__faith-map {
    margin: 2px 0 6px;
  }

  .ti__faith-list :global(.ti-rl) {
    display: grid;
    gap: 2px;
    padding: 4px 0;
    border-bottom: 1px dashed rgb(120 80 40 / 0.3);
  }

  .ti__faith-list :global(.ti-rl.is-gone) {
    opacity: 0.55;
  }

  .ti__faith-list :global(.ti-rl__docs) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .ti__faith-list :global(.ti-rl__docs span) {
    padding: 0 6px;
    border: 1px solid var(--ti-wood);
    border-radius: 999px;
    font-size: 11px;
  }

  .ti__faith-list :global(.ti-rl__meta) {
    font-size: 12px;
    color: var(--ti-muted);
  }

  .ti :global(.ti-faith) {
    color: color-mix(in srgb, var(--faith) 70%, #2a1a0a);
  }

  .ti__faith-list :global(.ti-link) {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    color: var(--ti-wood-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* Territory tab: land per people as bars, then the claims */
  .ti__terr-list :global(.ti-tr) {
    display: grid;
    grid-template-columns: minmax(110px, auto) minmax(80px, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .ti__terr-list :global(.ti-tr--free),
  .ti__terr-list :global(.ti-tr--claim) {
    display: block;
  }

  .ti__terr-list :global(.ti-tr--free) {
    color: var(--ti-muted);
  }

  .ti__terr-list :global(.ti-tr__bar) {
    height: 8px;
    overflow: hidden;
    background: rgb(120 80 40 / 0.15);
    border: 1px solid var(--ti-wood);
    border-radius: 2px;
  }

  .ti__terr-list :global(.ti-tr__bar span) {
    display: block;
    height: 100%;
  }

  .ti__terr-list :global(.ti-link) {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    color: var(--ti-wood-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .ti__terr-list :global(.ti-tr) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .ti__panel--chars {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .ti__panel--chars[hidden] {
    display: none;
  }

  .ti__tabs {
    display: flex;
    gap: 4px;
  }

  .ti__tab {
    padding: 4px 12px;
    background: none;
    border: 2px solid transparent;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    cursor: pointer;
  }

  .ti__tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--surface);
  }

  .ti__tab[aria-disabled='true'] {
    color: var(--muted);
    cursor: default;
  }

  .ti__tab small {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: lowercase;
  }

  .ti__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .ti__panel[hidden] {
    display: none;
  }

  .ti__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .ti__tool {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 4px 10px 4px 6px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .ti__tool:hover {
    transform: translateY(-2px);
  }

  .ti__tool[aria-pressed='true'] {
    background: var(--c-yellow);
    box-shadow: var(--shadow-sm);
  }

  .ti__swatch {
    width: 20px;
    height: 20px;
    background: var(--sw);
    border: 2px solid var(--ink);
    border-radius: 4px;
  }

  .ti__icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ti__pop {
    display: inline-flex;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .ti__pop b {
    font-weight: 700;
  }

  .ti__emoji {
    font-size: 16px;
    line-height: 1;
  }

  .ti__peoples {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .ti__people {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 3px 10px 3px 5px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .ti__people[aria-pressed='true'] {
    background: var(--c-yellow);
    box-shadow: var(--shadow-sm);
  }

  .ti__people .ti__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
  }

  .ti__note {
    width: 100%;
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  /* ---- profile (left) and chronicle (right) ---- */
  .ti__profile,
  .ti__chron {
    position: absolute;
    top: var(--top, 78px);
    z-index: 2;
    width: 290px;
    max-height: calc(100% - var(--top, 78px) - var(--dock, 150px));
    overflow-y: auto;
    padding: 10px 12px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    font-size: 13px;
  }

  .ti__profile {
    left: 10px;
  }

  .ti__chron {
    right: 10px;
  }

  .ti__profile[hidden],
  .ti__chron[hidden] {
    display: none;
  }

  .ti__chron-title {
    margin: 0 0 6px;
    font-size: var(--text-base);
  }

  .ti__chron > .ti__win-head {
    position: sticky;
    top: -10px;
    z-index: 1;
    margin: -10px -12px 4px;
    padding: 8px 10px 4px 12px;
    background: var(--ti-parch);
  }

  .ti__chron > .ti__win-head .ti__chron-title {
    margin: 0;
  }

  .ti__chron-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ti__chron-list :global(.ti-c__entry) {
    display: block;
    width: 100%;
    padding: 4px 6px;
    background: none;
    border: 0;
    border-radius: 6px;
    font: inherit;
    font-size: 12px;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .ti__chron-list :global(.ti-c__entry:hover) {
    background: var(--bg);
  }

  .ti__chron-list :global(.ti-c__entry.is-fav) {
    background: #fff3c4;
  }

  .ti__chron-list :global(.ti-c__yr) {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
  }

  .ti__chron-list :global(.ti-c--died) {
    color: #5a5a5a;
  }

  .ti__chron-list :global(.ti-c__empty) {
    color: var(--muted);
    font-size: 12px;
  }

  .ti__profile :global(.ti-p__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .ti__profile :global(.ti-p__name) {
    margin: 0;
    font-size: var(--text-lg);
  }

  .ti__profile :global(.ti-p__close) {
    width: 30px;
    height: 30px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 50%;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .ti__profile :global(.ti-p__meta) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0 6px;
    color: var(--muted);
  }

  .ti__profile :global(.ti-p__dot) {
    width: 10px;
    height: 10px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .ti__profile :global(.ti-dot--coast) {
    background: #3b7ddd;
  }

  .ti__profile :global(.ti-dot--forest) {
    background: #3aa64b;
  }

  .ti__profile :global(.ti-dot--mountain) {
    background: #9097a6;
  }

  .ti__profile :global(.ti-dot--steppe) {
    background: #d9443a;
  }

  .ti__profile :global(.ti-dot--islanders) {
    background: #f08c2e;
  }

  .ti__profile :global(.ti-p__traits) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 0 8px;
  }

  .ti__profile :global(.ti-p__village) {
    margin: 0 0 8px;
    font-size: 12px;
  }

  .ti__profile :global(.ti-p__traits span) {
    padding: 1px 8px;
    background: #e8f0ff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
  }

  .ti__profile :global(.ti-p__need) {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: center;
    gap: 6px;
    margin-bottom: 3px;
    font-size: 11px;
  }

  .ti__profile :global(.ti-p__bar) {
    height: 8px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
  }

  .ti__profile :global(.ti-p__bar span) {
    display: block;
    height: 100%;
    background: var(--c-green);
  }

  .ti__profile :global(.ti-p__fam) {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 3px 6px;
    margin: 8px 0;
    font-size: 12px;
  }

  .ti__profile :global(.ti-p__fam dt) {
    color: var(--muted);
  }

  .ti__profile :global(.ti-p__fam dd) {
    margin: 0;
  }

  .ti__profile :global(.ti-link) {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .ti__profile :global(.ti-dead) {
    color: var(--muted);
  }

  .ti__profile :global(.ti-p__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ti__profile :global(.ti-p__royal) {
    margin: 0;
    font-weight: 700;
  }

  .ti__profile :global(.ti-p__btn) {
    min-height: 34px;
    padding: 3px 10px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .ti__profile :global(.ti-p__btn[aria-pressed='true']) {
    background: var(--c-yellow);
  }

  .ti__profile :global(.ti-p__h) {
    margin: 10px 0 4px;
    font-size: var(--text-sm);
  }

  .ti__profile :global(.ti-p__story) {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }

  .ti__profile :global(.ti-p__yr) {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
  }

  /* ---- start screen ---- */
  .ti__start {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgb(20 40 90 / 0.45);
  }

  .ti__start[hidden] {
    display: none;
  }

  .ti__start-card {
    width: min(420px, 100%);
    padding: 22px 22px 18px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .ti__start-kicker {
    margin: 0 0 8px;
  }

  .ti__start-title {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .ti__start-tag {
    margin: 4px 0 16px;
    color: var(--muted);
  }

  .ti__start-btns {
    display: grid;
    gap: 8px;
  }

  .ti__start-btn {
    display: grid;
    gap: 2px;
    min-height: 54px;
    padding: 8px 14px;
    background: var(--bg);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-size: var(--text-base);
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .ti__start-btn[hidden] {
    display: none;
  }

  .ti__start-btn:hover {
    transform: translate(-2px, -2px);
  }

  .ti__start-btn small {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--muted);
  }

  .ti__start-btn--main {
    background: var(--c-green);
  }

  .ti__start-btn--main small {
    color: var(--ink);
  }

  .ti__start-note {
    margin: 12px 0 0;
    font-size: 11px;
    color: var(--muted);
  }

  .ti__share {
    min-height: 32px;
    font-size: 12px;
  }

  .ti__saved {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    opacity: 0;
    transition: opacity 400ms;
  }

  .ti__saved:global(.is-shown) {
    opacity: 1;
  }

  /* ---- population chart ---- */
  .ti__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0 0 4px;
    font-size: 11px;
  }

  .ti__legend span[hidden] {
    display: none;
  }

  .ti__legend span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ti__stats :global(.ti-s__svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ti__stats :global(.ti-s__grid) {
    stroke: #e2ddd0;
    stroke-width: 1;
  }

  .ti__stats :global(.ti-s__tick) {
    font-family: var(--font-mono);
    font-size: 8px;
    fill: var(--muted);
  }

  .ti__stats :global(.ti-s__label) {
    font-size: 9px;
    font-weight: 700;
    fill: var(--ink);
  }

  .ti__stats :global(.ti-s__cross) {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .ti__stats :global(.ti-s__empty) {
    margin: 4px 0;
    font-size: 12px;
    color: var(--muted);
  }

  .ti__stats-tip {
    margin: 2px 0 6px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .ti__stats-tip[hidden] {
    display: none;
  }

  /* Causes of death: one bar per cause, a single colour */
  .ti__deaths {
    display: grid;
    gap: 3px;
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }

  .ti__deaths :global(.ti-d) {
    display: grid;
    grid-template-columns: 84px 1fr 34px;
    align-items: center;
    gap: 6px;
  }

  .ti__deaths :global(.ti-d__bar) {
    height: 10px;
    background: var(--ti-parch-dark);
    border-radius: 2px;
  }

  .ti__deaths :global(.ti-d__bar span) {
    display: block;
    height: 100%;
    background: var(--ti-wood);
    border-radius: 0 4px 4px 0;
  }

  .ti__deaths :global(.ti-d b) {
    font-family: var(--ti-pixel);
    text-align: right;
  }

  .ti__deaths :global(.ti-d__none) {
    color: var(--ti-muted);
  }

  .ti__chron .ti__chron-title + .ti__chron-list {
    margin-top: 2px;
  }

  /* ---- rules window ---- */
  .ti__rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .ti__rule input {
    flex: 1 1 160px;
    accent-color: var(--ti-wood);
  }

  .ti__rule-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-transform: uppercase;
  }

  .ti__rule-end {
    font-size: 11px;
    color: var(--muted);
  }

  .ti__rel-list {
    display: grid;
    gap: 4px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }

  .ti__rel-list :global(.ti-r) {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(80px, 2fr) auto auto;
    align-items: center;
    gap: 8px;
  }

  .ti__rel-list :global(.ti-r__pair) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }

  .ti__rel-list :global(.ti-r__bar) {
    position: relative;
    height: 8px;
    background: linear-gradient(90deg, #ff8a80, #e2ddd0 50%, #9ee29b);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .ti__rel-list :global(.ti-r__bar span) {
    position: absolute;
    top: -4px;
    width: 4px;
    height: 12px;
    background: var(--ink);
    border-radius: 2px;
    transform: translateX(-50%);
  }

  .ti__rel-list :global(.ti-r.is-war .ti-r__word) {
    color: #c62828;
    font-weight: 700;
  }

  /* Armies (phase F): a morale bar that empties */
  .ti__rel-list :global(.ti-r__morale) {
    height: 8px;
    overflow: hidden;
    background: var(--ti-parch-dark, #e2ddd0);
    border: 2px solid var(--ti-wood-dark, var(--ink));
    border-radius: 2px;
  }

  .ti__rel-list :global(.ti-r__morale span) {
    display: block;
    height: 100%;
    background: #e0a43a;
  }

  .ti__profile :global(.ti-p__soldier) {
    margin: 2px 0;
    font-size: 12px;
  }

  /* World wonders (phase H): only the ones that stand, each with its picture */
  .ti__wonder-list :global(.ti-wd) {
    display: grid;
    grid-template-columns: 84px minmax(130px, auto) 1fr auto;
    align-items: center;
    gap: 8px;
  }

  /* Twice the map's pixels, so they stay sharp */
  .ti__wonder-list :global(.ti-wd__art) {
    width: 80px;
    height: 92px;
    image-rendering: pixelated;
    background: #e9dfc6;
    border: 2px solid #6b4f2f;
    border-radius: 6px;
  }

  .ti__wonder-list :global(.ti-wd__art--rising) {
    display: grid;
    place-items: center;
    width: 80px;
    height: 40px;
    font-size: 18px;
    border-style: dashed;
  }

  .ti__wonder-list :global(.ti-wd.is-rising) {
    grid-template-columns: 84px 1fr;
    color: var(--ti-muted);
    font-style: italic;
  }

  /* The inventions: clickable symbols, details below the row */
  .ti__tech-list :global(button.ti-t__icon) {
    padding: 0 1px;
    background: none;
    border: 0;
    border-radius: 4px;
    font: inherit;
    line-height: 1.4;
    cursor: pointer;
  }

  .ti__tech-list :global(button.ti-t__icon:hover),
  .ti__tech-list :global(button.ti-t__icon:focus-visible) {
    opacity: 1;
    filter: none;
    background: #f4e7c4;
  }

  .ti__tech-list :global(button.ti-t__icon.is-open) {
    opacity: 1;
    filter: none;
    background: #ffc83d;
    outline: 2px solid #6b4f2f;
  }

  .ti__tech-list :global(.ti-t__info) {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 10px;
    margin-top: 2px;
    padding: 8px 32px 8px 10px;
    background: #f7efd9;
    border: 2px solid #6b4f2f;
    border-radius: 8px;
    font-size: 12px;
  }

  .ti__tech-list :global(.ti-t__info p) {
    margin: 0 0 2px;
  }

  .ti__tech-list :global(.ti-t__info.is-unknown .ti-t__big) {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .ti__tech-list :global(.ti-t__big) {
    font-size: 28px;
    line-height: 1;
  }

  .ti__tech-list :global(.ti-t__does) {
    color: var(--ti-muted);
  }

  .ti__tech-list :global(.ti-t__first) {
    font-weight: 700;
    color: #9c6a12;
  }

  /* People dots inside running text */
  .ti__tech-list :global(.ti-t__info .ti-p__dot),
  .ti__wonder-list :global(.ti-wd .ti-p__dot) {
    display: inline-block;
    margin-right: 4px;
    vertical-align: -1px;
  }

  .ti__tech-list :global(.ti-t__other) {
    margin-right: 8px;
    white-space: nowrap;
  }

  .ti__tech-list :global(.ti-t__close) {
    position: absolute;
    top: 4px;
    right: 6px;
    padding: 0 4px;
    background: none;
    border: 0;
    font: 700 16px / 1 inherit;
    cursor: pointer;
  }


  .ti__wonder-list :global(.ti-wd.is-done b) {
    color: #9c6a12;
  }

  .ti__wonder-list :global(.ti-wd__does) {
    color: var(--ti-muted);
    font-size: 11px;
  }

  @media (max-width: 640px) {
    .ti__wonder-list :global(.ti-wd) {
      grid-template-columns: 84px 1fr;
    }

    .ti__wonder-list :global(.ti-wd > :nth-child(n + 3)) {
      grid-column: 2;
    }
  }

  .ti__league-list :global(.ti-lg) {
    display: grid;
    grid-template-columns: auto minmax(140px, auto) 1fr auto;
    align-items: center;
    gap: 8px;
  }

  .ti__league-list :global(.ti-lg__flag) {
    width: 14px;
    height: 10px;
    border: 2px solid var(--ti-wood-dark);
    border-radius: 2px;
  }

  .ti__league-list :global(.ti-lg__meta) {
    color: var(--ti-muted);
  }

  .ti__league-list :global(.ti-lg__h) {
    margin-top: 4px;
    font-weight: 700;
  }

  .ti__league-list :global(.ti-link) {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    color: var(--ti-wood-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .ti__league-list :global(.ti-c__entry) {
    display: block;
    width: 100%;
    padding: 2px 4px;
    background: none;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ti__league-list :global(.ti-c__yr) {
    margin-right: 4px;
    font-family: var(--ti-pixel);
    font-size: 10px;
    color: var(--ti-muted);
  }

  @media (max-width: 700px) {
    .ti__league-list :global(.ti-lg) {
      grid-template-columns: auto 1fr;
    }
  }

  .ti__rel-list :global(.ti-t__gift) {
    padding: 2px 8px;
    color: #fbefd2;
    background: linear-gradient(180deg, var(--ti-wood-light), var(--ti-wood));
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    box-shadow: 0 2px 0 var(--ti-wood-dark);
    font-family: var(--ti-pixel);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .ti__king-list :global(.ti-k) {
    display: grid;
    grid-template-columns: minmax(110px, auto) auto 1fr;
    align-items: center;
    gap: 8px;
  }

  .ti__culture-list :global(.ti-cu) {
    display: grid;
    grid-template-columns: minmax(110px, auto) auto minmax(140px, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .ti__culture-list :global(.ti-cu__works) {
    white-space: nowrap;
  }

  .ti__culture-list :global(.ti-cu__legends) {
    color: var(--muted);
  }

  .ti__culture-list :global(.ti-cu__gifts) {
    display: inline-flex;
    gap: 6px;
  }

  .ti__culture-list :global(.ti-cu__h) {
    margin-top: 4px;
    font-weight: 700;
  }

  .ti__culture-list :global(.ti-cu__work) {
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .ti__culture-list :global(.ti-cu) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .ti__king-list :global(.ti-k__realm) {
    color: var(--muted);
  }

  .ti__king-list :global(.ti-link) {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .ti__king-list :global(.ti-k) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .ti__tech-list :global(.ti-t) {
    display: grid;
    grid-template-columns: minmax(110px, auto) auto auto minmax(80px, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .ti__tech-list :global(.ti-t__icons) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1px;
    max-width: 260px;
    font-size: 13px;
  }

  .ti__tech-list :global(.ti-t__age) {
    margin-left: 4px;
    font-weight: 400;
    color: var(--ti-muted);
  }

  .ti__tech-list :global(.ti-t__icon) {
    opacity: 0.25;
    filter: grayscale(1);
  }

  .ti__tech-list :global(.ti-t__icon.is-known) {
    opacity: 1;
    filter: none;
  }

  .ti__tech-list :global(.ti-t__next) {
    color: var(--muted);
    white-space: nowrap;
  }

  .ti__tech-list :global(.ti-t__bar) {
    background: #e2ddd0;
  }

  .ti__tech-list :global(.ti-t__bar span) {
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: #ffc83d;
    border-radius: 999px;
    transform: none;
  }

  .ti__tech-list :global(.ti-t__gift) {
    padding: 2px 8px;
    font: inherit;
    font-weight: 700;
    color: var(--ink);
    background: #fff3c4;
    border: 2px solid var(--ink);
    border-radius: 999px;
    white-space: nowrap;
    cursor: pointer;
  }

  .ti__tech-list :global(.ti-t__gift:hover) {
    background: #ffe066;
  }

  @media (max-width: 700px) {
    .ti__tech-list :global(.ti-t) {
      grid-template-columns: 1fr auto;
    }

    .ti__tech-list :global(.ti-t__bar) {
      grid-column: 1 / -1;
    }
  }

  .ti__rel-list :global(.ti-r__none) {
    color: var(--muted);
  }

  .ti__rel-list :global(.ti-p__dot) {
    width: 10px;
    height: 10px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .ti__rel-list :global(.ti-dot--coast) {
    background: #3b7ddd;
  }

  .ti__rel-list :global(.ti-dot--forest) {
    background: #3aa64b;
  }

  .ti__rel-list :global(.ti-dot--mountain) {
    background: #9097a6;
  }

  .ti__rel-list :global(.ti-dot--steppe) {
    background: #d9443a;
  }

  .ti__rel-list :global(.ti-dot--islanders) {
    background: #f08c2e;
  }

  .ti__tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    margin: 0;
    padding: 3px 8px;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    pointer-events: none;
  }

  .ti__tip[hidden] {
    display: none;
  }

  .ti__random {
    margin-left: auto;
    min-height: 38px;
    padding: 4px 14px;
    background: var(--c-green);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .ti__random:hover {
    transform: translate(-2px, -2px);
  }

  .ti__hint {
    position: absolute;
    bottom: calc(100% - 4px);
    display: none;
  }

  /* ---- look: wood and parchment ---- */

  /* Every panel is a sheet of parchment in a wooden frame */
  .ti__top,
  .ti__bar,
  .ti__win,
  .ti__profile,
  .ti__chron,
  .ti__start-card {
    background:
      radial-gradient(120% 80% at 8% 0%, rgb(255 255 255 / 0.4), transparent 60%),
      radial-gradient(90% 70% at 100% 100%, rgb(150 100 40 / 0.2), transparent 60%),
      var(--ti-parch);
    border: 4px solid var(--ti-wood);
    border-radius: 6px;
    box-shadow:
      0 0 0 2px var(--ti-wood-dark),
      inset 0 0 0 1px rgb(255 240 200 / 0.6),
      inset 0 0 22px rgb(150 100 40 / 0.25),
      0 6px 14px rgb(30 15 5 / 0.35);
  }

  .ti__profile,
  .ti__chron {
    scrollbar-color: var(--ti-wood) var(--ti-parch-dark);
    scrollbar-width: thin;
  }

  .ti__title {
    font-family: var(--ti-pixel);
    font-size: 24px;
    font-weight: 700;
    color: var(--ti-wood-dark);
    text-shadow: 0 2px 0 var(--ti-gold-light);
  }

  /* Wooden buttons; the active one is golden */
  .ti__btn,
  .ti__bar-btn,
  .ti__win-close,
  .ti__current,
  .ti__tool,
  .ti__people,
  .ti__random,
  .ti__start-btn,
  .ti__profile :global(.ti-p__btn),
  .ti__profile :global(.ti-p__close),
  .ti__tech-list :global(.ti-t__gift) {
    color: #fbefd2;
    background: linear-gradient(180deg, var(--ti-wood-light), var(--ti-wood));
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 2px 0 var(--ti-wood-dark);
    font-family: var(--ti-pixel);
    font-weight: 600;
    text-shadow: 0 1px 0 rgb(40 20 5 / 0.5);
  }

  .ti__btn:hover,
  .ti__bar-btn:hover,
  .ti__win-close:hover,
  .ti__current:hover,
  .ti__tool:hover,
  .ti__people:hover,
  .ti__random:hover,
  .ti__start-btn:hover,
  .ti__profile :global(.ti-p__btn:hover),
  .ti__profile :global(.ti-p__close:hover),
  .ti__tech-list :global(.ti-t__gift:hover) {
    background: linear-gradient(180deg, #c48c55, #9a6534);
  }

  .ti__btn[aria-pressed='true'],
  .ti__bar-btn[aria-expanded='true'],
  .ti__current,
  .ti__tool[aria-pressed='true'],
  .ti__people[aria-pressed='true'],
  .ti__random,
  .ti__start-btn--main,
  .ti__profile :global(.ti-p__btn[aria-pressed='true']) {
    color: var(--ti-ink);
    background: linear-gradient(180deg, var(--ti-gold-light), var(--ti-gold));
    border-color: var(--ti-wood-dark);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.4);
  }

  .ti__random:hover,
  .ti__start-btn--main:hover {
    background: linear-gradient(180deg, #f7da85, #e2b03d);
  }

  .ti__start-btn small {
    color: rgb(251 239 210 / 0.85);
    text-shadow: none;
  }

  .ti__start-btn--main small {
    color: var(--ti-ink);
  }

  .ti__swatch {
    border-color: var(--ti-wood-dark);
  }

  /* Tabs like bookmarks */
  .ti__tab {
    color: var(--ti-ink);
    background: var(--ti-parch-dark);
    border: 2px solid var(--ti-wood);
    border-radius: 4px 4px 0 0;
    font-family: var(--ti-pixel);
    font-weight: 600;
  }

  .ti__tab[aria-selected='true'] {
    color: #fbefd2;
    background: var(--ti-wood);
    border-color: var(--ti-wood-dark);
    text-shadow: 0 1px 0 rgb(40 20 5 / 0.5);
  }

  .ti__rule-name,
  .ti__chron-title,
  .ti__win-title,
  .ti__profile :global(.ti-p__h),
  .ti__profile :global(.ti-p__name) {
    font-family: var(--ti-pixel);
    font-weight: 700;
    color: var(--ti-wood-dark);
  }

  .ti__profile :global(.ti-p__h) {
    padding-bottom: 2px;
    border-bottom: 2px dotted rgb(122 74 36 / 0.45);
  }

  .ti__profile :global(.ti-p__traits span),
  .ti__profile :global(.ti-v__chips span) {
    background: var(--ti-parch-dark);
    border: 2px solid var(--ti-wood);
    border-radius: 3px;
  }

  .ti__profile :global(.ti-p__bar),
  .ti__rel-list :global(.ti-r__bar) {
    border: 2px solid var(--ti-wood-dark);
    border-radius: 2px;
  }

  .ti__profile :global(.ti-p__bar) {
    background: var(--ti-parch-dark);
  }

  .ti__profile :global(.ti-p__bar span) {
    background: var(--ti-green);
  }

  .ti__profile :global(.ti-link),
  .ti__king-list :global(.ti-link) {
    color: var(--ti-wood-dark);
    text-decoration-color: var(--ti-wood-light);
  }

  .ti__chron-list :global(.ti-c__entry:hover) {
    background: var(--ti-parch-dark);
  }

  .ti__chron-list :global(.ti-c__entry.is-fav),
  .ti__profile :global(.ti-c__entry.is-fav) {
    background: rgb(242 207 107 / 0.45);
  }

  .ti__chron-list :global(.ti-c--died) {
    color: var(--ti-muted);
  }

  /* Place names in chronicle lines open the place */
  .ti__chron-list :global(.ti-vlink),
  .ti__profile :global(.ti-vlink) {
    text-decoration: underline dotted var(--ti-wood-light);
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .ti__tip {
    color: var(--ti-ink);
    background: var(--ti-parch);
    border: 2px solid var(--ti-wood);
    border-radius: 3px;
    box-shadow:
      0 0 0 1px var(--ti-wood-dark),
      0 3px 6px rgb(30 15 5 / 0.3);
  }

  .ti__start {
    background: rgb(40 25 10 / 0.5);
  }

  .ti__start-kicker {
    font-size: 40px;
    line-height: 1;
  }

  .ti__start-title {
    font-family: var(--ti-pixel);
    font-size: 46px;
    font-weight: 700;
    color: var(--ti-gold-light);
    text-shadow:
      0 3px 0 var(--ti-wood-dark),
      2px 0 0 var(--ti-wood-dark),
      -2px 0 0 var(--ti-wood-dark),
      0 -2px 0 var(--ti-wood-dark);
  }

  .ti__start-tag {
    font-style: italic;
  }

  /* ---- own characters: Life tab and editor ---- */
  .ti__mine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    width: 100%;
  }

  .ti__create {
    min-height: 34px;
    padding: 3px 12px;
    color: var(--ti-ink);
    background: linear-gradient(180deg, #bfe6ff, #7fc4ee);
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    box-shadow: 0 2px 0 var(--ti-wood-dark);
    font-family: var(--ti-pixel);
    font-weight: 600;
    cursor: pointer;
  }

  .ti__mine-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 12px;
  }

  .ti__mine-list :global(.ti-mine) {
    display: inline-flex;
    border: 2px solid var(--ti-wood);
    border-radius: 4px;
    overflow: hidden;
  }

  .ti__mine-list :global(.ti-mine button) {
    padding: 2px 6px;
    background: var(--ti-parch-light);
    border: 0;
    font: inherit;
    font-family: var(--ti-pixel);
    cursor: pointer;
  }

  .ti__mine-list :global(.ti-mine button:hover) {
    background: var(--ti-gold-light);
  }

  .ti__mine-list :global(.ti-mine__x) {
    border-left: 1px solid var(--ti-wood) !important;
  }

  .ti__mine-list :global(.ti-mine__empty) {
    color: var(--ti-muted);
  }

  .ti__place-hint {
    width: 100%;
    margin: 0;
    padding: 4px 8px;
    color: var(--ti-ink);
    background: #d6efff;
    border: 2px dashed var(--ti-wood);
    border-radius: 4px;
    font-family: var(--ti-pixel);
  }

  .ti__place-hint[hidden] {
    display: none;
  }

  .ti__editor {
    position: absolute;
    inset: 0;
    z-index: 12;
    display: grid;
    place-items: center;
    padding: 12px;
    background: rgb(40 25 10 / 0.5);
  }

  .ti__editor[hidden] {
    display: none;
  }

  .ti__editor-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: min(760px, 100%);
    max-height: calc(100% - 8px);
    background:
      radial-gradient(120% 80% at 8% 0%, rgb(255 255 255 / 0.4), transparent 60%),
      var(--ti-parch);
    border: 4px solid var(--ti-wood);
    border-radius: 6px;
    box-shadow:
      0 0 0 2px var(--ti-wood-dark),
      0 12px 30px rgb(30 15 5 / 0.45);
  }

  .ti__editor-head,
  .ti__editor-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
  }

  .ti__editor-head {
    border-bottom: 2px dotted rgb(122 74 36 / 0.45);
  }

  .ti__editor-head h2 {
    margin: 0;
    font-family: var(--ti-pixel);
    font-size: 20px;
    color: var(--ti-wood-dark);
  }

  .ti__editor-foot {
    justify-content: flex-end;
    border-top: 2px dotted rgb(122 74 36 / 0.45);
  }

  .ti__editor-close {
    width: 30px;
    height: 30px;
    color: #fbefd2;
    background: var(--ti-wood);
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
  }

  .ti__editor-body {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 14px;
    padding: 10px 12px;
    overflow-y: auto;
    scrollbar-color: var(--ti-wood) var(--ti-parch-dark);
  }

  .ti__editor-preview {
    position: sticky;
    top: 0;
    display: grid;
    gap: 8px;
    align-content: start;
    justify-items: center;
  }

  .ti__editor-preview canvas {
    width: 108px;
    height: 132px;
    background:
      linear-gradient(transparent 78%, #7fb069 78%),
      #cfe8f7;
    border: 3px solid var(--ti-wood);
    border-radius: 4px;
    image-rendering: pixelated;
  }

  .ti__editor-form {
    display: grid;
    gap: 7px;
    font-size: 13px;
  }

  .ti-e__row {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: 8px;
  }

  .ti-e__stat {
    grid-template-columns: 96px 1fr 28px;
  }

  .ti-e__label {
    font-family: var(--ti-pixel);
    font-weight: 600;
    color: var(--ti-wood-dark);
  }

  .ti-e__h {
    margin: 6px 0 0;
    padding-bottom: 2px;
    font-family: var(--ti-pixel);
    font-size: 15px;
    color: var(--ti-wood-dark);
    border-bottom: 2px dotted rgb(122 74 36 / 0.45);
  }

  .ti-e__hint {
    margin: 0;
    font-size: 12px;
    color: var(--ti-muted);
  }

  .ti-e__opts,
  .ti-e__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .ti-e__text,
  .ti-e__select {
    min-height: 32px;
    padding: 3px 8px;
    color: var(--ti-ink);
    background: var(--ti-parch-light);
    border: 2px solid var(--ti-wood);
    border-radius: 4px;
    font: inherit;
  }

  .ti-e__opt,
  .ti-e__chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 30px;
    padding: 2px 8px;
    color: var(--ti-ink);
    background: var(--ti-parch-light);
    border: 2px solid var(--ti-wood);
    border-radius: 4px;
    font-family: var(--ti-pixel);
    font-size: 12px;
    cursor: pointer;
  }

  .ti-e__opt[aria-pressed='true'],
  .ti-e__chip[aria-pressed='true'] {
    background: linear-gradient(180deg, var(--ti-gold-light), var(--ti-gold));
    border-color: var(--ti-wood-dark);
  }

  .ti-e__power[aria-pressed='true'] {
    background: linear-gradient(180deg, #bfe6ff, #7fc4ee);
  }

  .ti-e__swatch {
    width: 26px;
    height: 26px;
    background: var(--sw);
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    cursor: pointer;
  }

  .ti-e__swatch[aria-pressed='true'] {
    outline: 3px solid var(--ti-gold);
    outline-offset: 1px;
  }

  .ti-e__range {
    flex: 1 1 120px;
    accent-color: var(--ti-wood);
  }

  .ti-e__out {
    font-family: var(--ti-pixel);
    font-weight: 600;
  }

  .ti-e__check {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 6px;
    font-family: var(--ti-pixel);
    font-size: 12px;
  }

  .ti-e__btn {
    min-height: 36px;
    padding: 4px 14px;
    color: #fbefd2;
    background: linear-gradient(180deg, var(--ti-wood-light), var(--ti-wood));
    border: 2px solid var(--ti-wood-dark);
    border-radius: 4px;
    box-shadow: 0 2px 0 var(--ti-wood-dark);
    font-family: var(--ti-pixel);
    font-weight: 600;
    cursor: pointer;
  }

  .ti-e__btn--main {
    color: var(--ti-ink);
    background: linear-gradient(180deg, var(--ti-gold-light), var(--ti-gold));
  }

  @media (max-width: 640px) {
    .ti__editor-body {
      grid-template-columns: 1fr;
    }

    .ti__editor-preview {
      position: static;
      grid-template-columns: auto auto;
      align-items: center;
      justify-content: center;
    }

    .ti-e__row {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .ti-e__stat {
      grid-template-columns: 1fr 28px;
    }

    .ti-e__stat .ti-e__label {
      grid-column: 1 / -1;
    }
  }

  /* Profile: family name and memories (phase C) */
  .ti__profile :global(.ti-p__surname) {
    color: var(--ti-muted);
    font-weight: 400;
  }

  .ti__profile :global(.ti-p__mems) {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }

  .ti__profile :global(.ti-p__mems .is-grudge) {
    color: var(--ti-red);
  }

  .ti__profile :global(.ti-p__mems .is-thanks) {
    color: #3f6b22;
  }

  .ti__profile :global(.ti-p__mem-none) {
    margin: 0;
    font-size: 12px;
    font-style: italic;
    color: var(--ti-muted);
  }

  /* Profile: own characters, powers, abilities */
  .ti__profile :global(.ti-p__own) {
    margin: 0 0 4px;
    color: #1f6f9f;
    font-family: var(--ti-pixel);
    font-weight: 700;
  }

  .ti__profile :global(.ti-p__powers span) {
    background: #d6efff;
  }

  .ti__profile :global(.ti-p__stats) {
    margin: 6px 0 2px;
  }

  .ti__profile :global(.ti-p__stat) {
    grid-template-columns: 70px 1fr 18px;
