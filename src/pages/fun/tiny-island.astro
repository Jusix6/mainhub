<script>
  import { start } from '@/lib/tiny-island/main';

  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    stop = null;
    const root = document.querySelector<HTMLElement>('[data-tiny-island]');
    if (root) stop = start(root);
  });
</script>
