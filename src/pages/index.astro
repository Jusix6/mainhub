---
/**
 * Home page. Hero = the business card. Latest updates and the YouTube block
 * arrive in phase 5.
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BusinessCard from '@/components/BusinessCard.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CategoryStrip from '@/components/CategoryStrip.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';

const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  <section class="container hero">
    <BusinessCard class="hero__card" />
    <div class="hero__intro">
      <p class="meta">{SITE.tagline}</p>
      <h1 class="hero__title">
        Hi, I'm <span class="marker">{SITE.name}</span>.
      </h1>
      <p class="hero__bio">{SITE.bio}</p>
      <div class="hero__actions">
        <Button href="/projects" iconAfter="arrow" size="lg">{UI.actions.seeMyWork}</Button>
        <Button href="/links" color="--surface" icon="link" size="lg">{UI.nav.links}</Button>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="make-heading">
    <h2 id="make-heading" class="section-title">{UI.card.whatIMake}</h2>
    <CategoryStrip />
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-head">
      <h2 id="featured-heading">{UI.sections.featured}</h2>
      <Button href="/projects" color="--surface" iconAfter="arrow">{UI.actions.allProjects}</Button>
    </div>
    <ProjectGrid projects={featured} />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero :global(.hero__card) {
    justify-self: center;
  }

  .hero__intro {
    display: grid;
    gap: var(--space-3);
  }

  .hero__title {
    font-size: var(--text-2xl);
  }

  .hero__bio {
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .section {
    margin-top: var(--space-6);
  }

  .section-title {
    margin-bottom: var(--space-4);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
    }

    .hero :global(.hero__card) {
      justify-self: start;
    }
  }
</style>
