---
/**
 * Start page = the business card. The content hub lives at /hub. Visitors who
 * built their own start page in the creative mode see that instead (MyStartPage).
 */
import Bare from '@/layouts/Bare.astro';
import CardScreen from '@/components/CardScreen.astro';
import MyStartPage from '@/components/MyStartPage.astro';
import { SITE } from '@/data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  url: Astro.site?.href ?? SITE.url,
  email: SITE.email,
  jobTitle: SITE.tagline,
  address: { '@type': 'PostalAddress', addressCountry: 'CH' },
  sameAs: SITE.socials.map((s) => s.url),
};
---

<Bare description={SITE.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- The card is the page; its heading is for screen readers and search engines -->
  <h1 class="visually-hidden">{SITE.name}, {SITE.tagline}: apps, games, music and videos</h1>
  <CardScreen />
  <MyStartPage />
</Bare>
