---
/**
 * Start page = the business card. The content hub lives at /hub.
 */
import Bare from '@/layouts/Bare.astro';
import CardScreen from '@/components/CardScreen.astro';
import { SITE } from '@/data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  url: Astro.site?.href ?? SITE.url,
  email: SITE.email,
  jobTitle: SITE.tagline,
  address: { '@type': 'PostalAddress', addressCountry: 'CH' },
  sameAs: SITE.socials.map((s) => s.url),
};
---

<Bare description={SITE.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <CardScreen />
</Bare>
