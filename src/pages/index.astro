---
/**
 * Home page. Interim version until phases 3 and 4 add the business card hero
 * and the remaining sections.
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';

const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  <section class="container hero">
    <p class="meta">{SITE.tagline}</p>
    <h1>
      Hi, I'm <span class="marker">{SITE.name}</span>.
    </h1>
    <p class="hero__bio">{SITE.bio}</p>
  </section>

  <section class="container" aria-labelledby="featured-heading">
    <div class="section-head">
      <h2 id="featured-heading">{UI.sections.featured}</h2>
      <Button href="/projects" color="--surface" iconAfter="arrow">{UI.actions.allProjects}</Button>
    </div>
    <ProjectGrid projects={featured} />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero__bio {
    font-size: var(--text-lg);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
</style>
