---
/**
 * Legal documents (privacy policies, terms) from the `legal` collection.
 * URL: /privacy/<slug>, e.g. /privacy/forgot for the App Store listing.
 */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CategoryChip from '@/components/CategoryChip.astro';
import { UI } from '@/data/ui';
import { formatMonth, isoDate } from '@/lib/format';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { title, description, updated, languages } = doc.data;
const { Content } = await render(doc);
const project = doc.data.project ? await getEntry(doc.data.project) : undefined;
---

<Base title={title} description={description}>
  <article class="container legal">
    <header class="legal__head">
      {
        project && (
          <p class="legal__project">
            <CategoryChip category={project.data.category} />
            <a href={`/projects/${project.id}`}>{project.data.title}</a>
          </p>
        )
      }
      <h1>{title}</h1>
      <p class="meta">
        {UI.legal.updated}: <time datetime={isoDate(updated)}>{formatMonth(updated)}</time>
      </p>
      {
        languages.length > 1 && (
          <nav class="legal__langs" aria-label="Languages">
            {languages.map((l) => (
              <a href={`#${l.anchor}`} lang={l.code}>
                {l.label}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <div class="prose legal__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .legal {
    display: grid;
    gap: var(--space-4);
    max-width: 760px;
  }

  .legal__head {
    display: grid;
    gap: var(--space-3);
  }

  .legal__project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
  }

  .legal__langs {
    display: flex;
    gap: var(--space-2);
  }

  .legal__langs a {
    padding: var(--space-1) var(--space-3);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    background: var(--surface);
  }

  .legal__langs a:hover {
    background: var(--c-yellow);
  }

  .legal__body :global(h2) {
    scroll-margin-top: 80px;
    padding-top: var(--space-4);
  }
</style>
