---
/**
 * Same screen as /, kept so printed QR codes pointing at /card?src=print keep working.
 * Canonical points to / so search engines see one page.
 */
import Bare from '@/layouts/Bare.astro';
import CardScreen from '@/components/CardScreen.astro';
import { SITE } from '@/data/site';
---

<Bare description={SITE.description} canonical="/">
  <CardScreen />
</Bare>
