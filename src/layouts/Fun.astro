---
/**
 * Layout for the fun games on fun.jxsi.ch. The pages live under src/pages/fun/
 * and are built to dist/fun/, the worker serves them at the root of the fun
 * host. Links between fun pages are relative so they work on both hosts.
 * No main nav here: a small header with a way back to the main site is enough.
 */
import Head from '@/components/Head.astro';
import Icon from '@/components/Icon.astro';
import Sticker from '@/components/Sticker.astro';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { GAMES } from '@/data/games';
import { breadcrumbs, game, type JsonLd } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path on the fun host, e.g. "/the-button". Used for the canonical URL. */
  path: string;
  /** Relative link back to the fun index, "./" from a game page. */
  indexHref?: string;
  /** Absolute URL of a social preview image for this game. */
  image?: string;
  /** Full-window game: no header, footer or padding; the page brings its own top bar. */
  bare?: boolean;
  /** Keep the page out of search engines, e.g. while a game is still being built. */
  noIndex?: boolean;
}

const { title, description, path, indexHref, image, bare = false, noIndex = false } = Astro.props;
const canonical = new URL(path, SITE.fun.url).href;
const funHome = new URL('/', SITE.fun.url).href;
const slug = path.replace(/^\//, '');
// What search engines learn about the page: a game (with the way back to the list), or the list of games
const jsonLd: JsonLd[] = slug
  ? [game({ name: title, description, url: canonical, image }), breadcrumbs([[UI.fun.title, funHome], [title, canonical]])]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: UI.fun.indexTitle,
        itemListElement: GAMES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/${g.href}`, SITE.fun.url).href, name: g.title })),
      },
    ];
// A few lines about the game, under it (full-window games: for screen readers and search engines only)
const about = (UI.fun.about as Record<string, readonly string[]>)[slug];
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} · ${UI.fun.title}`} description={description} canonical={canonical} image={image} noIndex={noIndex} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">{UI.actions.skipToContent}</a>
    {!bare && (
    <header class="fun-header">
      <div class="container fun-header__inner">
        {
          indexHref ? (
            <a class="fun-header__brand" href={indexHref}>
              <Sticker color="--c-pink" rotate={-4}>{UI.fun.title}</Sticker>
            </a>
          ) : (
            <span class="fun-header__brand">
              <Sticker color="--c-pink" rotate={-4}>{UI.fun.title}</Sticker>
            </span>
          )
        }
        <a class="fun-header__back" href={`${SITE.url}/hub`}>
          {UI.fun.backToSite}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </header>
    )}
    <main id="main" tabindex="-1" class:list={[{ 'is-bare': bare }]}>
      <slot />
      {
        about && (
          <section class:list={['fun-about', { 'container': !bare, 'visually-hidden': bare }]} aria-labelledby="fun-about-title">
            <h2 id="fun-about-title">{UI.fun.aboutTitle}</h2>
            {about.map((p) => <p>{p}</p>)}
          </section>
        )
      }
    </main>
    {!bare && (
    <footer class="fun-footer">
      <p class="container meta">
        © {new Date().getFullYear()} {SITE.name} · {UI.footer.madeIn} · <a href={SITE.url}>{SITE.url.replace('https://', '')}</a>
      </p>
    </footer>
    )}
  </body>
</html>

<style>
  main.is-bare {
    padding: 0;
  }

  .fun-header {
    border-bottom: var(--line) solid var(--ink);
    background: var(--surface);
  }

  .fun-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
  }

  .fun-header__brand {
    text-decoration: none;
  }

  .fun-header__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 40px;
    padding: var(--space-1) var(--space-3);
    background: var(--c-yellow);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      transform var(--t-fast) var(--ease-pop),
      box-shadow var(--t-fast) var(--ease-pop);
  }

  .fun-header__back:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  main {
    padding-block: var(--space-5) var(--space-6);
  }

  /* As wide as most games (centred under them like the games are) */
  .fun-about {
    max-width: 720px;
    margin-top: var(--space-6);
  }

  .fun-about h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .fun-about p + p {
    margin-top: var(--space-2);
  }

  .fun-footer {
    border-top: var(--line) solid var(--ink);
    padding-block: var(--space-4);
  }
</style>
