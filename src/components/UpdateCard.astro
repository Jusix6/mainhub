---
/**
 * One update in a list: type sticker, date, title, the start of the text,
 * the cover as a thumbnail (right on wide cards, on top on narrow ones),
 * optional project chip.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getUpdateType } from '@/data/updateTypes';
import { formatDate, isoDate } from '@/lib/format';
import { updateExcerpt, updateUrl, type UpdateEntry } from '@/lib/updates';
import CategoryChip from './CategoryChip.astro';

interface Props {
  update: UpdateEntry;
  /** Resolved project entry, if the update references one. */
  project?: CollectionEntry<'projects'>;
  index?: number;
  heading?: 'h2' | 'h3';
}

const { update, project, index = 0, heading = 'h3' } = Astro.props;
const Heading = heading;
const type = getUpdateType(update.data.type);
const excerpt = updateExcerpt(update, 150);
const cover = update.data.cover;
---

<li class="ucard" style={`--type: var(${type.color}); --i: ${index}`} data-project={project?.id ?? ''}>
  <a class:list={['ucard__link', { 'has-cover': cover }]} href={updateUrl(update)}>
    {cover && <Image class="ucard__thumb" src={cover} alt="" widths={[320, 640]} sizes="(min-width: 700px) 220px, 100vw" loading="lazy" />}
    <div class="ucard__text">
      <div class="ucard__meta">
        <span class="ucard__type">{type.label}</span>
        <time class="meta" datetime={isoDate(update.data.date)}>{formatDate(update.data.date)}</time>
      </div>
      <Heading class="ucard__title">{update.data.title}</Heading>
      {excerpt && <p class="ucard__excerpt">{excerpt}</p>}
    </div>
  </a>
  {
    project && (
      <div class="ucard__project">
        <CategoryChip category={project.data.category} />
        <a href={`/projects/${project.id}`}>{project.data.title}</a>
      </div>
    )
  }
</li>

<style>
  .ucard {
    container-type: inline-size;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-left-width: 10px;
    border-left-color: var(--type);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition:
      transform var(--t-base) var(--ease-pop),
      box-shadow var(--t-base) var(--ease-pop);
    animation: ucard-in var(--t-slow) var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .ucard:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  .ucard[hidden] {
    display: none;
  }

  .ucard__link {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
  }

  .ucard__text {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .ucard__thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: top;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
  }

  /* Wide cards: text left, picture right */
  @container (min-width: 520px) {
    .ucard__link.has-cover {
      grid-template-columns: 1fr 220px;
      align-items: start;
    }

    .ucard__link.has-cover .ucard__thumb {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: 16 / 10;
    }
  }

  .ucard__excerpt {
    color: var(--muted);
  }

  .ucard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .ucard__type {
    padding: 1px var(--space-2);
    background: var(--type);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ucard__title {
    font-size: var(--text-xl);
  }

  .ucard__link:hover .ucard__title {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .ucard__project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
  }

  @keyframes ucard-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
