---
/**
 * Inline SVG icon by key. Two families:
 *  - stroke icons (categories, UI) drawn by hand below
 *  - brand icons (stores, platforms) from simple-icons, filled
 * All use currentColor. Decorative by default; pass `label` to make it accessible.
 */
import {
  siApple,
  siGoogleplay,
  siSteam,
  siItchdotio,
  siGumroad,
  siSpotify,
  siApplemusic,
  siBandcamp,
  siYoutube,
  siTwitch,
  siGithub,
} from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}

const STROKE: Record<string, string> = {
  // categories
  apps: 'M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z M8 8h3v3H8z M13 8h3v3h-3z M8 13h3v3H8z M13 13h3v3h-3z',
  games:
    'M6 9h12a4 4 0 0 1 4 4v3a3 3 0 0 1-5.2 2L15 16H9l-1.8 2A3 3 0 0 1 2 16v-3a4 4 0 0 1 4-4z M8 12v3 M6.5 13.5h3 M15.5 12.5h.01 M17.5 14.5h.01',
  music: 'M9 18V6l10-2v11 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M19 15a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  videos: 'M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z M10 8.5v7l6-3.5z',
  products: 'M3 8l9-5 9 5v8l-9 5-9-5z M3 8l9 5 9-5 M12 13v8',
  experiments: 'M9 3h6 M10 3v6l-5.5 9A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-3L14 9V3 M7.5 15h9',
  // ui
  link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1 M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
  mail: 'M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M3 7l9 6 9-6',
  arrow: 'M5 12h14 M13 6l6 6-6 6',
  external: 'M14 4h6v6 M20 4l-9 9 M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5',
  home: 'M3 11l9-8 9 8 M5 10v10h14V10 M10 20v-6h4v6',
  grid: 'M3 3h8v8H3z M13 3h8v8h-8z M3 13h8v8H3z M13 13h8v8h-8z',
  sparkle: 'M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z',
  star: 'M12 2l2.9 6.6L22 9.3l-5.5 4.8L18.2 21 12 17.3 5.8 21l1.7-6.9L2 9.3l7.1-.7z',
  download: 'M12 3v12 M7 10l5 5 5-5 M4 19h16',
  calendar: 'M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z M4 10h16 M8 2v4 M16 2v4 M8 14h3 M13 14h3',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7v5l3 2',
  rss: 'M4 11a9 9 0 0 1 9 9 M4 4a16 16 0 0 1 16 16 M5 19h.01',
};

const BRAND: Record<string, string> = {
  apple: siApple.path,
  playstore: siGoogleplay.path,
  steam: siSteam.path,
  itch: siItchdotio.path,
  gumroad: siGumroad.path,
  spotify: siSpotify.path,
  applemusic: siApplemusic.path,
  bandcamp: siBandcamp.path,
  youtube: siYoutube.path,
  twitch: siTwitch.path,
  github: siGithub.path,
};

const { name, size = 20, label, class: className } = Astro.props;

const stroke = STROKE[name];
const brand = BRAND[name];
if (!stroke && !brand) throw new Error(`Icon "${name}" does not exist. Add it to src/components/Icon.astro.`);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  {
    stroke ? (
      <path d={stroke} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    ) : (
      <path d={brand} fill="currentColor" />
    )
  }
</svg>

<style>
  .icon {
    flex: 0 0 auto;
    display: inline-block;
    vertical-align: -0.15em;
  }
</style>
