---
/**
 * Shared <head> content for every layout.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/archivo-black';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/retro.css';
import { SITE } from '@/data/site';
import ogDefault from '@/assets/og-default.png';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a social preview image; falls back to the default OG image. */
  image?: string;
  noIndex?: boolean;
  /** Canonical path override for alias pages. */
  canonical?: string;
}

const { title, description = SITE.description, image, noIndex = false, canonical: canonicalPath } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.name}, ${SITE.tagline}`;
// build.format 'file' makes pathname "/card.html" at build time; the public URL is "/card".
const cleanPath = canonicalPath ?? Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);
const ogImage = image ?? new URL(ogDefault.src, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Marks JS availability before first paint so no-JS fallbacks never flash (avoids layout shift).
     View transitions replace <html> attributes with the new page's, so re-apply after every swap. -->
<script is:inline>
  (function () {
    function apply() {
      document.documentElement.classList.add('js');
      // Easter egg skin (three clicks on the logo), remembered across pages
      try {
        if (localStorage.getItem('theme') === 'xp' || new URLSearchParams(location.search).get('xp') === '1') {
          document.documentElement.setAttribute('data-theme', 'xp');
        }
      } catch (e) {}
    }
    apply();
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#fff8e7" />
<meta name="author" content={SITE.name} />
{noIndex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.title} updates`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<ClientRouter />
