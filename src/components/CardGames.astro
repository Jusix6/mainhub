---
/**
 * Games hidden in the business card (/ and /card), full screen over the page:
 * - the "01" at the end of the card's number starts game 01, Card Breaker
 *   (src/lib/card-games/breakout.ts)
 * - the "S" of the name starts game 02, Snake (src/lib/card-games/snake.ts)
 * The game code loads only when it starts.
 */
import { getImage } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import { UI } from '@/data/ui';

const photo = await getImage({ src: portrait, width: 96, format: 'webp' });
const G = UI.card.games;
---

<div class="games" data-games data-portrait={photo.src} data-strings={JSON.stringify({ breakout: G.breakout, snake: G.snake })} hidden>
  <canvas class="games__canvas" data-games-canvas role="img" tabindex="-1"></canvas>
  <button class="games__close" type="button" data-games-close aria-label={G.close}>×</button>
</div>

<style>
  .games {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    animation: games-in 250ms ease-out both;
  }

  .games[hidden] {
    display: none;
  }

  .games__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: none;
    outline: none;
  }

  /* Snake is played with keys and swipes, the pointer may stay */
  .games__canvas[data-game='2'] {
    cursor: default;
  }

  .games__close {
    position: absolute;
    top: 10px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--surface);
    color: var(--ink);
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    font: 700 22px/1 var(--font-mono);
    cursor: pointer;
  }

  .games__close:hover {
    background: var(--c-yellow);
  }

  @keyframes games-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .games {
      animation: none;
    }
  }
</style>

<script>
  import type { BreakoutStrings } from '@/lib/card-games/breakout';
  import type { SnakeStrings } from '@/lib/card-games/snake';

  function setup() {
    const box = document.querySelector<HTMLElement>('[data-games]');
    if (!box || box.dataset.js) return;
    box.dataset.js = 'true';
    const canvas = box.querySelector<HTMLCanvasElement>('[data-games-canvas]')!;
    const close = box.querySelector<HTMLButtonElement>('[data-games-close]')!;
    const strings: { breakout: BreakoutStrings; snake: SnakeStrings } = JSON.parse(box.dataset.strings ?? '{}');
    let stop: (() => void) | null = null;
    let opener: HTMLElement | null = null;

    function exit() {
      stop?.();
      stop = null;
      box!.hidden = true;
      document.documentElement.style.overflow = '';
      opener?.focus({ preventScroll: true });
    }

    document.addEventListener('card:game', async (e) => {
      const detail = (e as CustomEvent<{ game: number; from?: DOMRect; opener?: HTMLElement }>).detail;
      if (stop || (detail.game !== 1 && detail.game !== 2)) return;
      opener = detail.opener ?? null;
      box!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      canvas.dataset.game = String(detail.game);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (detail.game === 1) {
        canvas.setAttribute('aria-label', strings.breakout.name);
        const { startBreakout } = await import('@/lib/card-games/breakout');
        stop = startBreakout({ canvas, strings: strings.breakout, portrait: box!.dataset.portrait ?? '', from: detail.from, reducedMotion, onExit: exit });
      } else {
        canvas.setAttribute('aria-label', strings.snake.name);
        const { startSnake } = await import('@/lib/card-games/snake');
        stop = startSnake({ canvas, strings: strings.snake, from: detail.from, reducedMotion, onExit: exit });
      }
      canvas.focus({ preventScroll: true });
    });
    close.addEventListener('click', exit);
    // Leaving the page ends the game too
    document.addEventListener('astro:before-swap', exit, { once: true });
  }

  document.addEventListener('astro:page-load', setup);
</script>
