---
/**
 * Project card for grids. Carries data attributes for the client-side filter.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getCategory } from '@/data/categories';
import CategoryChip from './CategoryChip.astro';
import StatusBadge from './StatusBadge.astro';
import { lqip } from '@/lib/lqip';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Load the cover eagerly (first card above the fold). */
  eager?: boolean;
  /** Stagger index for the entrance animation. */
  index?: number;
  /** Heading level, so the document outline stays sequential (h2 directly under a page h1). */
  heading?: 'h2' | 'h3';
}

const { project, eager = false, index = 0, heading = 'h3' } = Astro.props;
const Heading = heading;
const { title, tagline, category, status, cover, date } = project.data;
const cat = getCategory(category);
const placeholder = await lqip(cover);
---

<li
  class="card"
  style={`--accent: var(${cat.color}); --i: ${index}`}
  data-category={category}
  data-status={status}
  data-date={date.toISOString()}
>
  <a class="card__link" href={`/projects/${project.id}`}>
    <div class="card__media" style={placeholder ? `background-image: url("${placeholder}")` : undefined}>
      <Image
        src={cover}
        alt={title}
        widths={[400, 800, 1200]}
        sizes="(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        transition:name={`cover-${project.id}`}
      />
      <StatusBadge status={status} variant="auto" class="card__sticker" />
    </div>
    <div class="card__body">
      <CategoryChip category={category} />
      <Heading class="card__title">{title}</Heading>
      <p class="card__tagline">{tagline}</p>
    </div>
  </a>
</li>

<style>
  .card {
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition:
      transform var(--t-base) var(--ease-pop),
      box-shadow var(--t-base) var(--ease-pop);
    animation: card-in var(--t-slow) var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .card:hover {
    transform: translate(-3px, -3px) rotate(-0.6deg);
    box-shadow: var(--shadow-lg);
  }

  .card:active {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-sm);
  }

  .card[hidden] {
    display: none;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .card__media {
    position: relative;
    overflow: hidden;
    border-bottom: var(--line) solid var(--ink);
    border-radius: calc(var(--radius-lg) - var(--line)) calc(var(--radius-lg) - var(--line)) 0 0;
    background: var(--accent) center / cover no-repeat;
  }

  .card__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* Only sticker-style statuses render as absolutely positioned; badges never appear on cards */
  .card__media :global(.sticker) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .card__media :global(.badge) {
    display: none;
  }

  .card__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .card__body > :global(.chip) {
    justify-self: start;
  }

  .card__title {
    font-size: var(--text-xl);
  }

  .card__tagline {
    color: var(--muted);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
