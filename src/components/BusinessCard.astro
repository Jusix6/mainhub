---
/**
 * 3D business card. Front: name + tagline. Back: what I make, contact, socials.
 * - Tap/click/Enter flips it (rotateY 180deg).
 * - Fine pointers get a subtle tilt that follows the cursor.
 * - Standalone (/ and /card) it is a card in your hand instead: grab a corner
 *   (a turn symbol shows up, a little outside the corner too) and drag to turn
 *   it freely in 3D, so the back comes round; grab the middle and drag to move
 *   it anywhere on the screen; double-click to put it back. No click flip, no
 *   flip-back pill (it stays for the keyboard: Enter turns the card over).
 * - Easter egg (standalone): put the card exactly into a corner of the window
 *   and it bounces around like the old DVD screensaver, a new colour every
 *   time it touches the edge of the window; a perfect corner hit makes it
 *   spin. Grab it to stop it, double-click to bring it home (and white again).
 * - Games (standalone, CardGames.astro): the "01" of the number starts Card
 *   Breaker, the "S" of the name starts Snake. "Creative" in "Creative License"
 *   starts the creative mode (CreativeMode.astro).
 * - Without JS both faces render stacked and fully usable.
 * - With reduced motion the flip becomes a crossfade (see global reduced-motion rule).
 * All content comes from src/data/site.ts and src/data/ui.ts.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { CATEGORIES } from '@/data/categories';
import { getVideoCount } from '@/lib/youtube';
import { getLinkType } from '@/data/linkTypes';
import portrait from '@/assets/portrait.png';
import signature from '@/assets/signature.png';
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  /** Larger type and buttons, for the standalone /card page. */
  standalone?: boolean;
  class?: string;
}

const { standalone = false, class: className } = Astro.props;
const lic = SITE.license;

// The card page: the front is no button (that would leave no room for one inside it),
// and the "01" at the end of the number is one: it starts game 01 (CardGames.astro)
const Front = (standalone ? 'div' : 'button') as 'div';
const frontAttrs: Record<string, string | number> = standalone ? { tabindex: 0, role: 'group', 'aria-label': UI.card.frontLabel } : { type: 'button' };
const cut = lic.number.lastIndexOf('-') + 1;
const numberHead = lic.number.slice(0, cut);
const numberTail = lic.number.slice(cut);
// Creative mode hides in the first word of the licence kind ("Creative License")
const kindHead = lic.kind.split(' ')[0];
const kindTail = lic.kind.slice(kindHead.length);
// Game 02 hides in the "S" of the name (the first one, any case)
const sAt = SITE.name.search(/s/i);

// "HT / WT / HAIR / EYES" row of the license: project counts per category, live from the
// collection. Videos is the YouTube upload count (worker.js keeps it current between builds
// through data-stat="videos").
const projects = await getCollection('projects');
const videos = String(await getVideoCount());
const stats = CATEGORIES.slice(0, 4).map((c) => ({
  slug: c.slug,
  label: c.label.split(' ')[0],
  value:
    c.slug === 'videos'
      ? videos
      : ((lic.statOverrides as Partial<Record<string, string>>)[c.slug] ?? String(projects.filter((p) => p.data.category === c.slug).length)),
}));
---

<div
  class:list={['scene', { 'scene--standalone': standalone }, className]}
  data-business-card
  role={standalone ? 'group' : undefined}
  aria-label={standalone ? UI.card.turnLabel : undefined}
>
  {
    standalone && (
      <span class="turn-cursor" data-turn-cursor aria-hidden="true">
        <Icon name="rotate" size={22} />
      </span>
    )
  }
  <div class="tilt" data-tilt>
    <div class="card" data-card>
      {
        standalone && (
          <Fragment>
            <span class="mark mark--tl" data-mark aria-hidden="true" />
            <span class="mark mark--tr" data-mark aria-hidden="true" />
            <span class="mark mark--br" data-mark aria-hidden="true" />
            <span class="mark mark--bl" data-mark aria-hidden="true" />
          </Fragment>
        )
      }
      <Front class="face face--front" data-flip {...frontAttrs}>

        <span class="lic__head">
          <span class="lic__region">{lic.region}</span>
          {
            standalone && kindHead ? (
              <span class="lic__kind">
                {/* prettier-ignore */}
                <button class="lic__game lic__game--kind" type="button" data-creative-start aria-label={UI.creative.enter}>{kindHead}</button>{kindTail}
              </span>
            ) : (
              <span class="lic__kind">{lic.kind}</span>
            )
          }
        </span>

        <span class="lic__number">
          <span class="lic__label">Number</span>
          {
            standalone ? (
              <Fragment>
                {/* prettier-ignore */}
                {numberHead}<button class="lic__game" type="button" data-game="1" aria-label={UI.card.games.play}>{numberTail}</button>
              </Fragment>
            ) : (
              lic.number
            )
          }
        </span>

        <span class="lic__photo">
          <Image src={portrait} alt="" width={300} height={375} densities={[1, 2]} loading="eager" />
        </span>

        <span class="lic__fields">
          <span class="lic__row lic__row--big">
            <span><b>DOB</b> {lic.dob}</span>
            <span><b>EXP</b> {lic.exp}</span>
          </span>
          <span class="lic__row lic__row--stats">
            {
              stats.map((s) => (
                <span data-stat={s.slug}>
                  <b>{s.label}</b>
                  <span data-stat-value>{s.value}</span>
                </span>
              ))
            }
          </span>
          <span class="lic__row">
            <span><b>Issue date</b> {lic.issued}</span>
            <span><b>Class</b> {lic.cls}</span>
            <span><b>Restr</b> {lic.restr}</span>
            <span><b>Endorse</b> {lic.endorse}</span>
          </span>
        </span>

        <span class="lic__barcode" aria-hidden="true"></span>
        <span class="lic__sig" aria-hidden="true">
          <Image src={signature} alt="" width={370} height={174} densities={[1, 2]} loading="eager" />
        </span>

        <span class="lic__id">
          {
            standalone && sAt >= 0 ? (
              <span class="lic__name">
                {/* prettier-ignore */}
                {SITE.name.slice(0, sAt)}<button class="lic__game lic__game--name" type="button" data-game="2" aria-label={UI.card.games.playSnake}>{SITE.name[sAt]}</button>{SITE.name.slice(sAt + 1)}
              </span>
            ) : (
              <span class="lic__name">{SITE.name}</span>
            )
          }
          {lic.addressLines.map((l) => <span class="lic__addr">{l}</span>)}
        </span>

        {
          standalone ? (
            <span class="front__hint front__hint--turn">
              <Icon name="rotate" size={16} />
              {UI.card.turnHint}
            </span>
          ) : (
            <span class="front__hint">
              {UI.actions.tapToFlip}
              <Icon name="arrow" size={16} />
            </span>
          )
        }
      </Front>

      <div class="face face--back" data-back>
        <div class="back__head">
          <span class="back__name">{SITE.name}</span>
          <a class="back__mail" href={`mailto:${SITE.email}`}>
            <Icon name="mail" size={16} />
            {SITE.email}
          </a>
        </div>

        <ul class="back__cats" aria-label={UI.card.whatIMake}>
          {
            CATEGORIES.map((c) => (
              <li style={`--chip: var(${c.color})`}>
                <Icon name={c.icon} size={13} />
                {c.label}
              </li>
            ))
          }
        </ul>

        <ul class="back__socials" aria-label="Social links">
          {
            SITE.socials.map((s) => {
              const def = getLinkType(s.type);
              // On small cards only the networks that appear twice (the two YouTube channels) keep their label
              const dup = SITE.socials.filter((o) => o.type === s.type).length > 1;
              return (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="me noopener"
                    aria-label={`${def.label}: ${s.handle}`}
                    style={`--c: var(${def.color})`}
                    data-dup={dup ? '' : undefined}
                  >
                    <Icon name={def.icon} size={16} />
                    <span>{s.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="back__actions">
          <Button href="/contact.vcf" icon="download" download="jusi.vcf">
            {UI.actions.saveContact}
          </Button>
          {
            standalone ? (
              <Button href="/hub" color="--c-pink" iconAfter="arrow">
                {UI.card.visit}
              </Button>
            ) : (
              <Button href="/projects" color="--c-pink" iconAfter="arrow">
                {UI.actions.seeMyWork}
              </Button>
            )
          }
        </div>

        <button class="back__flip" type="button" data-flip>
          {UI.card.flipBack}
          <Icon name="arrow" size={16} />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .scene {
    container-type: inline-size;
    width: min(100%, 560px);
    perspective: 1400px;
  }

  .scene--standalone {
    width: min(100%, 680px);
    /* Dragging the card must not scroll, zoom or select text */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Four invisible points in the corners: the browser tells where they end up on screen, however the card is turned */
  .scene--standalone .card {
    position: relative;
  }

  .mark {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .mark--tl {
    top: 0;
    left: 0;
  }

  .mark--tr {
    top: 0;
    right: 0;
  }

  .mark--br {
    right: 0;
    bottom: 0;
  }

  .mark--bl {
    bottom: 0;
    left: 0;
  }

  /* The card follows the hand directly, no easing behind the pointer */
  .scene--standalone .tilt {
    transition: none;
  }

  /* A card in your hand: the middle moves it, the corners turn it (see the script) */
  .scene--standalone .face--front,
  .scene--standalone .face--back {
    cursor: grab;
  }

  .scene--standalone.is-moving .face {
    cursor: grabbing;
  }

  .scene--standalone .face--back :is(a, button) {
    cursor: pointer;
  }

  /* A page that fits the window gets no scrollbars from a card turned or moved over its edge */
  :global(html.card-free),
  :global(html.card-free body) {
    overflow: clip;
  }

  /* While turning (or hovering a corner) the turn symbol replaces the cursor */
  :global(html.card-turning),
  :global(html.card-turning *) {
    cursor: none !important;
  }

  .turn-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    display: none;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    color: var(--ink);
    background: var(--c-yellow);
    border: 2px solid var(--ink);
    border-radius: 50%;
    box-shadow: 2px 2px 0 var(--ink);
    pointer-events: none;
  }

  .turn-cursor.is-shown {
    display: grid;
  }

  /* Easter egg: the DVD screensaver. A new colour at every edge of the window */
  .scene.is-dvd .face--front,
  .scene.is-dvd .face--back {
    background: color-mix(in srgb, var(--dvd, #fff) 45%, #fff);
    transition: background-color 250ms ease;
  }

  /* …and a flash when it hits a corner exactly */
  .scene.is-dvd-corner .face {
    animation: dvd-corner 900ms ease-out;
  }

  @keyframes dvd-corner {
    30% {
      box-shadow:
        0 0 0 10px var(--c-yellow),
        var(--shadow-lg);
    }
  }

  /* Game 01 hides in the number, game 02 in the "S" of the name: they look like the rest until the pointer finds them */
  .lic__game {
    padding: 0 1px;
    margin: 0 -1px;
    background: none;
    color: inherit;
    border: 0;
    border-radius: 3px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .lic__game:hover,
  .lic__game:focus-visible {
    background: var(--c-yellow);
    color: var(--ink);
  }

  /* Gliding back after a double-click */
  .scene.is-gliding,
  :global([data-card-move].is-gliding) {
    transition:
      translate 600ms var(--ease-pop),
      scale 150ms var(--ease-out);
  }

  .scene--standalone.is-gliding .tilt {
    transition: transform 600ms var(--ease-pop);
  }

  /* The keyboard can still turn the card over from the back; the pill only shows when focused */
  .scene--standalone .back__flip:not(:focus-visible) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    border: 0;
  }

  .tilt {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform var(--t-fast) var(--ease-out);
  }

  .card {
    display: grid;
    /* 85:55 card ratio as a minimum; grows if the back face needs more room */
    min-height: calc(100cqw * 55 / 85);
    transform: rotateY(var(--flip, 0deg));
    transform-style: preserve-3d;
    transition: transform var(--t-slow) var(--ease-pop);
  }

  .card.is-flipped {
    --flip: 180deg;
  }

  .face {
    grid-area: 1 / 1;
    position: relative;
    min-width: 0;
    padding: clamp(14px, 5cqw, 28px);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    color: var(--ink);
    text-align: left;
  }

  /* Front: a "creative license" laid out like a certain fake Hawaiian ID */
  .face--front {
    --lic-blue: #2a5bd7;
    --lic-red: #d3202f;
    display: grid;
    grid-template-columns: 30% 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    grid-template-areas:
      'photo head'
      'photo number'
      'photo fields'
      'barcode sig'
      'id id';
    gap: clamp(4px, 1.4cqw, 10px) clamp(8px, 3cqw, 18px);
    align-items: start;
    padding: clamp(10px, 3.5cqw, 22px);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-body);
    text-transform: uppercase;
  }

  /* Grid content; the overlays keep their own positioning */
  .face--front > :not(.front__hint) {
    position: relative;
    z-index: 1;
    min-width: 0;
  }


  .lic__head {
    grid-area: head;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px clamp(4px, 2cqw, 12px);
    color: var(--lic-blue);
    line-height: 1;
  }

  .lic__region {
    font-family: var(--font-display);
    font-size: clamp(18px, 7cqw, 46px);
    letter-spacing: -0.02em;
    transform: skewX(-8deg);
    white-space: nowrap;
  }

  .lic__kind {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(9px, 2.4cqw, 14px);
    line-height: 1.05;
    white-space: nowrap;
  }

  .lic__number {
    grid-area: number;
    display: flex;
    align-items: baseline;
    gap: clamp(4px, 1.5cqw, 10px);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(11px, 3.8cqw, 24px);
    color: var(--lic-red);
    letter-spacing: 0.02em;
  }

  .lic__label {
    font-size: 0.55em;
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  .lic__photo {
    grid-area: photo;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: #ff9a3c;
  }

  .lic__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lic__fields {
    grid-area: fields;
    display: grid;
    gap: clamp(3px, 1.2cqw, 8px);
    align-content: start;
    font-family: var(--font-mono);
    font-size: clamp(7px, 2.2cqw, 13px);
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .lic__row {
    display: flex;
    flex-wrap: wrap;
    gap: 2px clamp(6px, 2.4cqw, 16px);
    min-width: 0;
  }

  .lic__row > span {
    white-space: nowrap;
  }

  .lic__row b {
    display: inline-block;
    margin-right: 0.4em;
    font-weight: 700;
    color: var(--ink);
  }

  .lic__row--big {
    font-size: clamp(9px, 3.2cqw, 20px);
    font-weight: 700;
    color: var(--lic-red);
  }

  .lic__row--stats > span {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
  }

  .lic__row--stats b {
    margin: 0;
  }

  .lic__barcode {
    grid-area: barcode;
    display: block;
    height: clamp(12px, 4.5cqw, 28px);
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 3px,
      var(--ink) 3px 4px,
      transparent 4px 7px,
      var(--ink) 7px 10px,
      transparent 10px 12px,
      var(--ink) 12px 13px,
      transparent 13px 16px
    );
  }

  /* Real pen signature (src/assets/signature.png, extracted via scripts/signature-from-photo.mjs) */
  .lic__sig {
    grid-area: sig;
    align-self: center;
    display: block;
    padding-left: 10cqw;
  }

  .lic__sig :global(img) {
    width: auto;
    height: clamp(22px, 8cqw, 52px);
    transform: rotate(-3deg);
  }

  .lic__id {
    grid-area: id;
    display: grid;
    gap: 1px;
    padding-right: 40%;
    line-height: 1.1;
  }

  .lic__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 6cqw, 40px);
    letter-spacing: 0.02em;
  }

  .lic__addr {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(8px, 2.6cqw, 15px);
    letter-spacing: 0.04em;
  }

  .front__hint {
    position: absolute;
    right: clamp(14px, 5cqw, 28px);
    bottom: clamp(14px, 5cqw, 28px);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 3px 10px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    animation: hint-nudge 1.8s var(--ease-pop) 1.2s 2;
  }

  .face--front {
    isolation: isolate;
  }

  /* Back */
  .face--back {
    display: grid;
    gap: clamp(8px, 3cqw, 16px);
    align-content: start;
    background: var(--surface);
    /* room at the bottom for the "flip back" pill, mirroring the front */
    padding-bottom: calc(clamp(14px, 5cqw, 28px) + 44px);
    transform: rotateY(180deg);
  }

  .back__head {
    display: grid;
    gap: 2px;
  }

  .back__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 6cqw, 30px);
    line-height: 1;
  }

  .back__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: clamp(12px, 3cqw, 14px);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .back__mail:hover {
    text-decoration: underline;
  }

  .back__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .back__cats li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px;
    background: var(--chip);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .back__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Icon + short label so the two YouTube channels can be told apart without a tap */
  .back__socials a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 10px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    white-space: nowrap;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    transition:
      transform var(--t-fast) var(--ease-pop),
      box-shadow var(--t-fast) var(--ease-pop),
      background var(--t-fast);
  }

  .back__socials a:hover {
    background: var(--c);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  .back__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .back__actions :global(.btn) {
    flex: 1 1 auto;
    min-height: 40px;
    padding-block: var(--space-1);
    font-size: clamp(12px, 3.2cqw, 15px);
  }

  /* Same pill as the front hint, same spot: bottom right */
  .back__flip {
    position: absolute;
    right: clamp(14px, 5cqw, 28px);
    bottom: clamp(14px, 5cqw, 28px);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 32px;
    padding: 3px 10px;
    background: var(--c-yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .back__flip :global(.icon) {
    transform: scaleX(-1);
  }

  .back__flip:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  /* The hint on the front and the flip pill on the back stay above the card content */
  .front__hint,
  .back__flip {
    z-index: 3;
  }

  /* No JS (html.js is set inline in <head> before first paint): both faces stacked, no 3D */
  :global(html:not(.js)) .tilt,
  :global(html:not(.js)) .card {
    transform: none;
    transform-style: flat;
  }

  :global(html:not(.js)) .card {
    gap: var(--space-4);
    min-height: 0;
  }

  :global(html:not(.js)) .face {
    grid-area: auto;
    transform: none;
  }

  :global(html:not(.js)) .face--front {
    aspect-ratio: 85 / 55;
  }

  :global(html:not(.js)) .front__hint,
  :global(html:not(.js)) .back__flip {
    display: none;
  }

  /* Reduced motion: crossfade instead of rotation */
  /* Small cards (phones): tighten the back so the card keeps a card-like shape
     instead of growing into a tall sheet. Labels stay only where they tell two
     networks apart; everything else shrinks a step. */
  @container (max-width: 420px) {
    .face--back {
      gap: 8px;
      padding-bottom: calc(clamp(14px, 5cqw, 28px) + 40px);
    }

    .back__cats {
      gap: 3px 4px;
    }

    .back__cats li {
      padding: 0 6px;
      font-size: 11px;
      border-width: 2px;
    }

    .back__socials {
      gap: 4px;
    }

    /* Five pills must fit one row at 360px viewports (289px inner width) */
    .back__socials a {
      gap: 5px;
      min-height: 32px;
      padding: 0 7px;
      font-size: 11px;
      letter-spacing: 0.03em;
    }

    .back__socials a:not([data-dup]) span {
      display: none;
    }

    .back__actions {
      gap: 6px;
    }

    .back__actions :global(.btn) {
      min-height: 36px;
      padding: 4px 10px;
      font-size: 12px;
    }

    .back__flip {
      min-height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt,
    .card {
      transform: none !important;
    }

    .face {
      transform: none;
      transition: opacity var(--t-base) ease;
    }

    .card:not(.is-flipped) .face--back,
    .card.is-flipped .face--front {
      opacity: 0;
      pointer-events: none;
    }
  }

  @keyframes hint-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-2px);
    }
  }
</style>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setupCard(scene: HTMLElement) {
    if (scene.dataset.js) return;
    scene.dataset.js = 'true';

    const tilt = scene.querySelector<HTMLElement>('[data-tilt]');
    const card = scene.querySelector<HTMLElement>('[data-card]');
    const back = scene.querySelector<HTMLElement>('[data-back]');
    const front = scene.querySelector<HTMLButtonElement>('.face--front');
    const backFlip = back?.querySelector<HTMLButtonElement>('[data-flip]');
    if (!tilt || !card || !back || !front) return;

    let flipped = false;

    /** Keep the hidden face out of the tab order and the accessibility tree. */
    function faces() {
      back!.toggleAttribute('inert', !flipped);
      front!.toggleAttribute('inert', flipped);
      if (front!.tagName === 'BUTTON') front!.setAttribute('aria-expanded', String(flipped));
    }

    if (scene.classList.contains('scene--standalone')) {
      freeCard();
      return;
    }

    function render() {
      card!.classList.toggle('is-flipped', flipped);
      faces();
    }

    function flip(to: boolean) {
      flipped = to;
      render();
      // Move focus to the face that is now visible, after the animation has started.
      const target = flipped ? backFlip : front;
      window.setTimeout(() => target?.focus({ preventScroll: true }), reducedMotion.matches ? 0 : 350);
    }

    scene.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((btn) => {
      btn.addEventListener('click', () => flip(!flipped));
    });

    // Cursor tilt on devices with a mouse. Max ±8 degrees.
    if (finePointer.matches && !reducedMotion.matches) {
      scene.addEventListener('pointermove', (e) => {
        const r = scene.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ry', `${(x * 16).toFixed(2)}deg`);
        tilt.style.setProperty('--rx', `${(-y * 16).toFixed(2)}deg`);
      });
      scene.addEventListener('pointerleave', () => {
        tilt.style.removeProperty('--rx');
        tilt.style.removeProperty('--ry');
      });
    }

    render();

    /**
     * The standalone card: a card in your hand. Near a corner (also a little
     * outside it, like the rotate handle in an image editor) a turn symbol
     * shows up; drag there to turn the card freely in 3D, so the back comes
     * round. Drag anywhere else on it to move it around the screen. A
     * double-click puts it back. Clicks without moving still reach the links
     * and buttons on the back. With reduced motion a sideways drag at a
     * corner turns the card over with a crossfade instead.
     */
    function freeCard() {
      const ac = new AbortController();
      const opts = { signal: ac.signal };
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
      const html = document.documentElement;
      // The page may move a wrapper (with things on it, like a medal) instead of just the card
      const mover = scene.closest<HTMLElement>('[data-card-move]') ?? scene;
      const symbol = scene.querySelector<HTMLElement>('[data-turn-cursor]');
      // The scene's perspective would make "fixed" relative to the card: the symbol lives on the body
      if (symbol) {
        document.body.append(symbol);
        ac.signal.addEventListener('abort', () => {
          symbol.remove();
          html.classList.remove('card-turning');
        });
      }
      const rad = (d: number) => (d * Math.PI) / 180;

      let rx = 0;
      let ry = 0;
      let tx = 0;
      let ty = 0;
      let spin = 0;
      let vx = 0;
      let vy = 0;
      let swing = 0;
      let swallow = false;
      type Drag = { mode: 'turn' | 'move'; corner: number; id: number; x: number; y: number; t: number; started: boolean };
      let drag: Drag | null = null;

      function apply() {
        tilt!.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
        tilt!.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
        mover.style.translate = `${tx.toFixed(1)}px ${ty.toFixed(1)}px`;
        // Which side faces us: the card's normal after rotateX(rx) rotateY(ry)
        const backNow = Math.cos(rad(rx)) * Math.cos(rad(ry)) < 0;
        if (backNow !== flipped) {
          flipped = backNow;
          faces();
          }
      }

      /** Reduced motion: no 3D, the faces crossfade (CSS on .is-flipped). */
      function turnOverFlat() {
        flipped = !flipped;
        card!.classList.toggle('is-flipped', flipped);
        faces();
      }

      /** Keep at least the middle of the card on screen. */
      function clamp() {
        const r = mover.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const m = 24;
        if (cx < m) tx += m - cx;
        if (cx > window.innerWidth - m) tx -= cx - (window.innerWidth - m);
        if (cy < m) ty += m - cy;
        if (cy > window.innerHeight - m) ty -= cy - (window.innerHeight - m);
      }

      /**
       * Where the pointer is: near a corner (turn, inside or a little outside),
       * on the card (move) or neither. The corners are where the card really
       * shows on screen, turned and in perspective (the four marks).
       */
      const marks = [...scene.querySelectorAll<HTMLElement>('[data-mark]')];
      function zone(x: number, y: number): { mode: 'turn' | 'move'; corner: number } | null {
        const pts = marks.map((m) => {
          const r = m.getBoundingClientRect();
          return { x: r.left, y: r.top };
        });
        const reach = finePointer.matches ? 40 : 56;
        let corner = -1;
        let near = Infinity;
        pts.forEach((p, i) => {
          const d = Math.hypot(x - p.x, y - p.y);
          if (d < near) {
            near = d;
            corner = i;
          }
        });
        if (near < reach) return { mode: 'turn', corner };
        // Inside the four corners (ray casting)
        let inside = false;
        for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
          const a = pts[i];
          const b = pts[j];
          if (a.y > y !== b.y > y && x < ((b.x - a.x) * (y - a.y)) / (b.y - a.y) + a.x) inside = !inside;
        }
        return inside ? { mode: 'move', corner: -1 } : null;
      }

      /** The turn symbol follows the pointer, curled the way of its corner. */
      function showSymbol(x: number, y: number, corner: number | null) {
        if (!symbol) return;
        const on = corner !== null && corner >= 0;
        symbol.classList.toggle('is-shown', on);
        html.classList.toggle('card-turning', on);
        if (!on) return;
        symbol.style.translate = `${x}px ${y}px`;
        symbol.style.rotate = `${corner * 90}deg`;
      }

      function stopSpin() {
        cancelAnimationFrame(spin);
        spin = 0;
      }

      /** After letting go of a turn, the card spins on a little and slows down. */
      function coast() {
        vx *= 0.93;
        vy *= 0.93;
        ry += vx;
        rx += vy;
        apply();
        spin = Math.abs(vx) + Math.abs(vy) > 0.05 ? requestAnimationFrame(coast) : 0;
      }

      window.addEventListener(
        'pointermove',
        (e) => {
          if (!drag) {
            if (e.pointerType === 'mouse') {
              const z = zone(e.clientX, e.clientY);
              showSymbol(e.clientX, e.clientY, z ? z.corner : null);
            }
            return;
          }
          if (e.pointerId !== drag.id) return;
          const dx = e.clientX - drag.x;
          const dy = e.clientY - drag.y;
          if (!drag.started) {
            if (Math.hypot(dx, dy) < 4) return;
            drag.started = true;
            scene.classList.toggle('is-moving', drag.mode === 'move');
          }
          const now = performance.now();
          const dt = Math.max(1, now - drag.t);
          drag.x = e.clientX;
          drag.y = e.clientY;
          drag.t = now;
          if (drag.mode === 'move') {
            tx += dx;
            ty += dy;
            mover.style.translate = `${tx.toFixed(1)}px ${ty.toFixed(1)}px`;
            clamp();
            apply();
            return;
          }
          if (drag.mode === 'turn') {
            showSymbol(e.clientX, e.clientY, drag.corner);
            if (reducedMotion.matches) {
              swing += dx;
              if (Math.abs(swing) > 80) {
                swing = 0;
                turnOverFlat();
              }
              return;
            }
            // Sideways turns around the upright axis, up and down tips it
            ry += dx * 0.5;
            rx -= dy * 0.5;
            // Degrees per frame (16 ms) for the coast after letting go, at most 18
            const cap = (v: number) => Math.max(-18, Math.min(18, v));
            vx = cap(((dx * 0.5) / dt) * 16);
            vy = cap(((-dy * 0.5) / dt) * 16);
            apply();
          }
        },
        opts,
      );

      window.addEventListener(
        'pointerdown',
        (e) => {
          if (e.button !== 0 || !e.isPrimary) return;
          const z = zone(e.clientX, e.clientY);
          if (!z) return;
          // A link or button on the card keeps its click (unless grabbed at a corner)
          const target = e.target as Element;
          const control = target.closest('a, button:not(.face--front), input');
          if (z.mode === 'move' && control && scene.contains(control)) {
            drag = { mode: 'move', corner: -1, id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now(), started: false };
            return;
          }
          if (z.mode === 'turn') {
            e.preventDefault();
            showSymbol(e.clientX, e.clientY, z.corner);
          }
          stopSpin();
          stopDvd();
          swing = 0;
          scene.classList.remove('is-gliding');
          mover.classList.remove('is-gliding');
          drag = { mode: z.mode, corner: z.corner, id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now(), started: false };
        },
        opts,
      );

      /*
       * Easter egg: put the card exactly into a corner of the window (its
       * corners on screen, from the marks, within 14 px, 22 on touch) and it
       * bounces around like the DVD screensaver: flat, front up, diagonally,
       * a new colour every time it touches an edge; a perfect corner hit makes
       * it spin and flash. Grabbing it stops it, a double-click brings it home.
       */
      const DVD_COLORS = ['--c-pink', '--c-blue', '--c-yellow', '--c-green', '--c-purple', '--c-orange'];
      let dvd = 0;
      let dvdColor = -1;
      let dvdLast = 0;
      let dvdX = 1;
      let dvdY = 1;
      let base = { left: 0, top: 0, width: 0, height: 0 };

      function inCorner() {
        const pts = marks.map((m) => m.getBoundingClientRect());
        const left = Math.min(...pts.map((p) => p.left));
        const right = Math.max(...pts.map((p) => p.left));
        const top = Math.min(...pts.map((p) => p.top));
        const bottom = Math.max(...pts.map((p) => p.top));
        const tol = finePointer.matches ? 14 : 22;
        const x = Math.abs(left) <= tol || Math.abs(right - window.innerWidth) <= tol;
        const y = Math.abs(top) <= tol || Math.abs(bottom - window.innerHeight) <= tol;
        return x && y;
      }

      function nextColor() {
        const n = DVD_COLORS.length;
        dvdColor = dvdColor < 0 ? Math.floor(Math.random() * n) : (dvdColor + 1 + Math.floor(Math.random() * (n - 1))) % n;
        scene.style.setProperty('--dvd', `var(${DVD_COLORS[dvdColor]})`);
        scene.classList.add('is-dvd');
      }

      /** Where the card would be without being moved (to bounce off the window edges). */
      function measureBase() {
        const r = mover.getBoundingClientRect();
        base = { left: r.left - tx, top: r.top - ty, width: r.width, height: r.height };
      }

      function startDvd() {
        if (dvd || reducedMotion.matches) return;
        stopSpin();
        // Flat and front up, like a logo
        scene.classList.add('is-gliding');
        rx = Math.round(rx / 360) * 360;
        ry = Math.round(ry / 360) * 360;
        apply();
        window.setTimeout(() => scene.classList.remove('is-gliding'), 650);
        measureBase();
        // Off and away from the corner it sits in
        dvdX = base.left + tx + base.width / 2 < window.innerWidth / 2 ? 1 : -1;
        dvdY = base.top + ty + base.height / 2 < window.innerHeight / 2 ? 1 : -1;
        nextColor();
        dvdLast = performance.now();
        dvd = requestAnimationFrame(stepDvd);
      }

      function stopDvd() {
        cancelAnimationFrame(dvd);
        dvd = 0;
      }

      function stepDvd(now: number) {
        const dt = Math.min(0.05, (now - dvdLast) / 1000);
        dvdLast = now;
        const w = window.innerWidth;
        const h = window.innerHeight;
        const speed = Math.max(110, Math.min(w, h) * 0.22);
        let hitX = false;
        let hitY = false;
        // A card wider (or taller) than the window only bounces the other way
        if (base.width < w) {
          tx += dvdX * speed * dt;
          if (base.left + tx <= 0) {
            tx = -base.left;
            dvdX = 1;
            hitX = true;
          } else if (base.left + tx + base.width >= w) {
            tx = w - base.width - base.left;
            dvdX = -1;
            hitX = true;
          }
        }
        if (base.height < h) {
          ty += dvdY * speed * dt;
          if (base.top + ty <= 0) {
            ty = -base.top;
            dvdY = 1;
            hitY = true;
          } else if (base.top + ty + base.height >= h) {
            ty = h - base.height - base.top;
            dvdY = -1;
            hitY = true;
          }
        }
        if (hitX || hitY) nextColor();
        // The moment everyone waits for: right into a corner (a few pixels of slack)
        const near = (v: number, edge: number) => Math.abs(v - edge) <= 4;
        const corner =
          (hitX && (near(base.top + ty, 0) || near(base.top + ty + base.height, h))) || (hitY && (near(base.left + tx, 0) || near(base.left + tx + base.width, w)));
        if (corner) {
          scene.classList.remove('is-dvd-corner');
          void scene.offsetWidth;
          scene.classList.add('is-dvd-corner');
          scene.classList.add('is-gliding');
          ry += 360;
          window.setTimeout(() => scene.classList.remove('is-gliding'), 650);
        }
        apply();
        dvd = requestAnimationFrame(stepDvd);
      }

      const end = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const was = drag;
        drag = null;
        scene.classList.remove('is-moving');
        if (e.pointerType !== 'mouse') showSymbol(0, 0, null);
        else {
          const z = zone(e.clientX, e.clientY);
          showSymbol(e.clientX, e.clientY, z ? z.corner : null);
        }
        if (!was.started) return;
        // A drag is not a click: the button or link it started on stays quiet
        swallow = true;
        window.setTimeout(() => (swallow = false), 0);
        if (was.mode === 'turn' && !reducedMotion.matches && Math.abs(vx) + Math.abs(vy) > 0.3) spin = requestAnimationFrame(coast);
        if (was.mode === 'move' && inCorner()) startDvd();
      };
      window.addEventListener('pointerup', end, opts);
      window.addEventListener('pointercancel', end, opts);
      window.addEventListener(
        'click',
        (e) => {
          if (!swallow) return;
          swallow = false;
          e.stopPropagation();
          e.preventDefault();
        },
        { capture: true, signal: ac.signal },
      );

      // A pointer click on the front does nothing (no flip); the keyboard turns the card over
      function turnOver() {
        stopSpin();
        if (reducedMotion.matches) {
          turnOverFlat();
        } else {
          scene.classList.add('is-gliding');
          ry = Math.round(ry / 180) * 180 + 180;
          rx = Math.round(rx / 180) * 180;
          apply();
        }
        const target = flipped ? backFlip : front;
        window.setTimeout(() => target?.focus({ preventScroll: true }), reducedMotion.matches ? 0 : 350);
      }
      // The flip-back pill (keyboard only) and Enter or space on the front itself
      backFlip?.addEventListener('click', (e) => {
        if (e.detail === 0) turnOver();
      });
      front!.addEventListener('keydown', (e) => {
        if (e.target !== front || (e.key !== 'Enter' && e.key !== ' ')) return;
        e.preventDefault();
        turnOver();
      });

      // Game 01: the "01" of the number, game 02: the "S" of the name (CardGames.astro starts them)
      scene.querySelectorAll<HTMLButtonElement>('[data-game]').forEach((el) =>
        el.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          scene.dispatchEvent(
            new CustomEvent('card:game', { bubbles: true, detail: { game: Number(btn.dataset.game), from: (flipped ? back! : front!).getBoundingClientRect(), opener: btn } }),
          );
        }),
      );

      // Creative mode: the "Creative" of the licence (CreativeMode.astro starts it)
      scene.querySelector<HTMLButtonElement>('[data-creative-start]')?.addEventListener('click', (e) => {
        scene.dispatchEvent(new CustomEvent('card:creative', { bubbles: true, detail: { opener: e.currentTarget } }));
      });

      // Double-click: back to where it started, front up
      scene.addEventListener(
        'dblclick',
        (e) => {
          if ((e.target as Element).closest('a, button:not(.face--front)')) return;
          stopSpin();
          stopDvd();
          scene.classList.remove('is-dvd', 'is-dvd-corner');
          dvdColor = -1;
          scene.classList.add('is-gliding');
          mover.classList.add('is-gliding');
          rx = Math.round(rx / 360) * 360;
          ry = Math.round(ry / 360) * 360;
          tx = 0;
          ty = 0;
          if (reducedMotion.matches && flipped) turnOverFlat();
          apply();
          window.setTimeout(() => {
            scene.classList.remove('is-gliding');
            mover.classList.remove('is-gliding');
          }, 650);
        },
        opts,
      );

      // Keep the card on screen when the window gets smaller
      window.addEventListener(
        'resize',
        () => {
          if (dvd) {
            measureBase();
            return;
          }
          clamp();
          apply();
        },
        opts,
      );

      // No scrollbars when the card sticks out, as long as the page fits the window at rest
      const fits = () => html.scrollHeight <= window.innerHeight + 1 && html.scrollWidth <= window.innerWidth + 1;
      html.classList.toggle('card-free', fits());
      ac.signal.addEventListener('abort', () => {
        html.classList.remove('card-free');
        stopDvd();
      });

      apply();
      faces();
    }
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-business-card]').forEach(setupCard);
  }

  document.addEventListener('astro:page-load', init);
</script>
