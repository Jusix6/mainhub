---
/**
 * 3D business card. Front: name + tagline. Back: what I make, contact, socials.
 * - Tap/click/Enter flips it (rotateY 180deg).
 * - Fine pointers get a subtle tilt that follows the cursor.
 * - Without JS both faces render stacked and fully usable.
 * - With reduced motion the flip becomes a crossfade (see global reduced-motion rule).
 * All content comes from src/data/site.ts and src/data/ui.ts.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { CATEGORIES } from '@/data/categories';
import { getLinkType } from '@/data/linkTypes';
import portrait from '@/assets/portrait.png';
import signature from '@/assets/signature.png';
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  /** Larger type and buttons, for the standalone /card page. */
  standalone?: boolean;
  class?: string;
}

const { standalone = false, class: className } = Astro.props;
const lic = SITE.license;

// "HT / WT / HAIR / EYES" row of the license: project counts per category, live from the collection
const projects = await getCollection('projects');
const stats = CATEGORIES.slice(0, 4).map((c) => ({
  label: c.label.split(' ')[0],
  value: String(projects.filter((p) => p.data.category === c.slug).length),
}));
---

<div
  class:list={['scene', { 'scene--standalone': standalone }, className]}
  data-business-card
  data-tired={JSON.stringify(UI.card.tired)}
>
  <div class="tilt" data-tilt>
    <div class="card" data-card>
      <button class="face face--front" type="button" data-flip>
        <span class="face__tired" data-tired-text hidden></span>

        <span class="lic__head">
          <span class="lic__region">{lic.region}</span>
          <span class="lic__kind">{lic.kind}</span>
        </span>

        <span class="lic__number">
          <span class="lic__label">Number</span>
          {lic.number}
        </span>

        <span class="lic__photo">
          <Image src={portrait} alt="" width={300} height={375} densities={[1, 2]} loading="eager" />
        </span>

        <span class="lic__fields">
          <span class="lic__row lic__row--big">
            <span><b>DOB</b> {lic.dob}</span>
            <span><b>EXP</b> {lic.exp}</span>
          </span>
          <span class="lic__row lic__row--stats">
            {
              stats.map((s) => (
                <span>
                  <b>{s.label}</b>
                  {s.value}
                </span>
              ))
            }
          </span>
          <span class="lic__row">
            <span><b>Issue date</b> {lic.issued}</span>
            <span><b>Class</b> {lic.cls}</span>
            <span><b>Restr</b> {lic.restr}</span>
            <span><b>Endorse</b> {lic.endorse}</span>
          </span>
        </span>

        <span class="lic__barcode" aria-hidden="true"></span>
        <span class="lic__sig" aria-hidden="true">
          <Image src={signature} alt="" width={370} height={174} densities={[1, 2]} loading="eager" />
        </span>

        <span class="lic__id">
          <span class="lic__name">{SITE.name}</span>
          {lic.addressLines.map((l) => <span class="lic__addr">{l}</span>)}
        </span>

        <span class="front__hint">
          {UI.actions.tapToFlip}
          <Icon name="arrow" size={16} />
        </span>
      </button>

      <div class="face face--back" data-back>
        <span class="face__tired" data-tired-text hidden aria-live="polite"></span>
        <div class="back__head">
          <span class="back__name">{SITE.name}</span>
          <a class="back__mail" href={`mailto:${SITE.email}`}>
            <Icon name="mail" size={16} />
            {SITE.email}
          </a>
        </div>

        <ul class="back__cats" aria-label={UI.card.whatIMake}>
          {
            CATEGORIES.map((c) => (
              <li style={`--chip: var(${c.color})`}>
                <Icon name={c.icon} size={13} />
                {c.label}
              </li>
            ))
          }
        </ul>

        <ul class="back__socials" aria-label="Social links">
          {
            SITE.socials.map((s) => {
              const def = getLinkType(s.type);
              return (
                <li>
                  <a href={s.url} target="_blank" rel="me noopener" aria-label={`${def.label}: ${s.handle}`} style={`--c: var(${def.color})`}>
                    <Icon name={def.icon} size={18} />
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="back__actions">
          <Button href="/contact.vcf" icon="download" download="jusi.vcf">
            {UI.actions.saveContact}
          </Button>
          {
            standalone ? (
              <Button href="/hub" color="--c-pink" iconAfter="arrow">
                {UI.card.visit}
              </Button>
            ) : (
              <Button href="/projects" color="--c-pink" iconAfter="arrow">
                {UI.actions.seeMyWork}
              </Button>
            )
          }
        </div>

        <button class="back__flip" type="button" data-flip>
          {UI.card.flipBack}
          <Icon name="arrow" size={16} />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .scene {
    container-type: inline-size;
    width: min(100%, 560px);
    perspective: 1400px;
  }

  .scene--standalone {
    width: min(100%, 680px);
  }

  .tilt {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform var(--t-fast) var(--ease-out);
  }

  .card {
    display: grid;
    /* 85:55 card ratio as a minimum; grows if the back face needs more room */
    min-height: calc(100cqw * 55 / 85);
    transform: rotateY(var(--flip, 0deg));
    transform-style: preserve-3d;
    transition: transform var(--t-slow) var(--ease-pop);
  }

  .card.is-flipped {
    --flip: 180deg;
  }

  .face {
    grid-area: 1 / 1;
    position: relative;
    min-width: 0;
    padding: clamp(14px, 5cqw, 28px);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    color: var(--ink);
    text-align: left;
  }

  /* Front: a "creative license" laid out like a certain fake Hawaiian ID */
  .face--front {
    --lic-blue: #2a5bd7;
    --lic-red: #d3202f;
    display: grid;
    grid-template-columns: 30% 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    grid-template-areas:
      'photo head'
      'photo number'
      'photo fields'
      'barcode sig'
      'id id';
    gap: clamp(4px, 1.4cqw, 10px) clamp(8px, 3cqw, 18px);
    align-items: start;
    padding: clamp(10px, 3.5cqw, 22px);
    background: #fff;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-body);
    text-transform: uppercase;
  }

  /* Grid content; the overlays keep their own positioning */
  .face--front > :not(.front__hint):not(.face__tired) {
    position: relative;
    z-index: 1;
    min-width: 0;
  }


  .lic__head {
    grid-area: head;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px clamp(4px, 2cqw, 12px);
    color: var(--lic-blue);
    line-height: 1;
  }

  .lic__region {
    font-family: var(--font-display);
    font-size: clamp(18px, 7cqw, 46px);
    letter-spacing: -0.02em;
    transform: skewX(-8deg);
    white-space: nowrap;
  }

  .lic__kind {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(9px, 2.4cqw, 14px);
    line-height: 1.05;
    white-space: nowrap;
  }

  .lic__number {
    grid-area: number;
    display: flex;
    align-items: baseline;
    gap: clamp(4px, 1.5cqw, 10px);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(11px, 3.8cqw, 24px);
    color: var(--lic-red);
    letter-spacing: 0.02em;
  }

  .lic__label {
    font-size: 0.55em;
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  .lic__photo {
    grid-area: photo;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: #ff9a3c;
  }

  .lic__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lic__fields {
    grid-area: fields;
    display: grid;
    gap: clamp(3px, 1.2cqw, 8px);
    align-content: start;
    font-family: var(--font-mono);
    font-size: clamp(7px, 2.2cqw, 13px);
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .lic__row {
    display: flex;
    flex-wrap: wrap;
    gap: 2px clamp(6px, 2.4cqw, 16px);
    min-width: 0;
  }

  .lic__row > span {
    white-space: nowrap;
  }

  .lic__row b {
    display: inline-block;
    margin-right: 0.4em;
    font-weight: 700;
    color: var(--ink);
  }

  .lic__row--big {
    font-size: clamp(9px, 3.2cqw, 20px);
    font-weight: 700;
    color: var(--lic-red);
  }

  .lic__row--stats > span {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
  }

  .lic__row--stats b {
    margin: 0;
  }

  .lic__barcode {
    grid-area: barcode;
    display: block;
    height: clamp(12px, 4.5cqw, 28px);
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 3px,
      var(--ink) 3px 4px,
      transparent 4px 7px,
      var(--ink) 7px 10px,
      transparent 10px 12px,
      var(--ink) 12px 13px,
      transparent 13px 16px
    );
  }

  /* Real pen signature (src/assets/signature.png, extracted via scripts/signature-from-photo.mjs) */
  .lic__sig {
    grid-area: sig;
    align-self: center;
    display: block;
    padding-left: 10cqw;
  }

  .lic__sig :global(img) {
    width: auto;
    height: clamp(22px, 8cqw, 52px);
    transform: rotate(-3deg);
  }

  .lic__id {
    grid-area: id;
    display: grid;
    gap: 1px;
    padding-right: 40%;
    line-height: 1.1;
  }

  .lic__name {
    font-family: var(--font-display);
    font-size: clamp(16px, 6cqw, 40px);
    letter-spacing: 0.02em;
  }

  .lic__addr {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(8px, 2.6cqw, 15px);
    letter-spacing: 0.04em;
  }

  .front__hint {
    position: absolute;
    right: clamp(14px, 5cqw, 28px);
    bottom: clamp(14px, 5cqw, 28px);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 3px 10px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    animation: hint-nudge 1.8s var(--ease-pop) 1.2s 2;
  }

  .face--front {
    isolation: isolate;
  }

  /* Back */
  .face--back {
    display: grid;
    gap: clamp(8px, 3cqw, 16px);
    align-content: start;
    background: var(--surface);
    /* room at the bottom for the "flip back" pill, mirroring the front */
    padding-bottom: calc(clamp(14px, 5cqw, 28px) + 44px);
    transform: rotateY(180deg);
  }

  .back__head {
    display: grid;
    gap: 2px;
  }

  .back__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 6cqw, 30px);
    line-height: 1;
  }

  .back__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: clamp(12px, 3cqw, 14px);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .back__mail:hover {
    text-decoration: underline;
  }

  .back__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .back__cats li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px;
    background: var(--chip);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .back__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .back__socials a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--surface);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    transition:
      transform var(--t-fast) var(--ease-pop),
      box-shadow var(--t-fast) var(--ease-pop),
      background var(--t-fast);
  }

  .back__socials a:hover {
    background: var(--c);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  .back__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .back__actions :global(.btn) {
    flex: 1 1 auto;
    min-height: 40px;
    padding-block: var(--space-1);
    font-size: clamp(12px, 3.2cqw, 15px);
  }

  /* Same pill as the front hint, same spot: bottom right */
  .back__flip {
    position: absolute;
    right: clamp(14px, 5cqw, 28px);
    bottom: clamp(14px, 5cqw, 28px);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 32px;
    padding: 3px 10px;
    background: var(--c-yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.8cqw, 13px);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease-pop);
  }

  .back__flip :global(.icon) {
    transform: scaleX(-1);
  }

  .back__flip:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  /* Easter egg: after too many flips the card gets tired and hides everything but a line of text */
  .face__tired {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: clamp(14px, 5cqw, 28px);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: clamp(16px, 4.5cqw, 26px);
    text-align: center;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    animation: tired-in var(--t-base) ease-out both;
  }

  .face__tired[hidden] {
    display: none;
  }

  /* The flip controls stay on top of the overlay so the card can always be turned */
  .front__hint,
  .back__flip {
    z-index: 3;
  }

  @keyframes tired-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* No JS (html.js is set inline in <head> before first paint): both faces stacked, no 3D */
  :global(html:not(.js)) .tilt,
  :global(html:not(.js)) .card {
    transform: none;
    transform-style: flat;
  }

  :global(html:not(.js)) .card {
    gap: var(--space-4);
    min-height: 0;
  }

  :global(html:not(.js)) .face {
    grid-area: auto;
    transform: none;
  }

  :global(html:not(.js)) .face--front {
    aspect-ratio: 85 / 55;
  }

  :global(html:not(.js)) .front__hint,
  :global(html:not(.js)) .back__flip {
    display: none;
  }

  /* Reduced motion: crossfade instead of rotation */
  @media (prefers-reduced-motion: reduce) {
    .tilt,
    .card {
      transform: none !important;
    }

    .face {
      transform: none;
      transition: opacity var(--t-base) ease;
    }

    .card:not(.is-flipped) .face--back,
    .card.is-flipped .face--front {
      opacity: 0;
      pointer-events: none;
    }
  }

  @keyframes hint-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-2px);
    }
  }
</style>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setupCard(scene: HTMLElement) {
    if (scene.dataset.js) return;
    scene.dataset.js = 'true';

    const tilt = scene.querySelector<HTMLElement>('[data-tilt]');
    const card = scene.querySelector<HTMLElement>('[data-card]');
    const back = scene.querySelector<HTMLElement>('[data-back]');
    const front = scene.querySelector<HTMLButtonElement>('.face--front');
    const backFlip = back?.querySelector<HTMLButtonElement>('[data-flip]');
    if (!tilt || !card || !back || !front) return;

    let flipped = false;

    // Easter egg: count flips, show a message after a while, reset at the last stage.
    type Stage = { at: number; text: string; reset?: boolean };
    const stages: Stage[] = JSON.parse(scene.dataset.tired ?? '[]');
    const tiredTexts = scene.querySelectorAll<HTMLElement>('[data-tired-text]');
    let flips = 0;
    let resetTimer = 0;

    function setTired(text: string | null) {
      scene.classList.toggle('is-tired', text !== null);
      tiredTexts.forEach((el) => {
        el.textContent = text ?? '';
        el.hidden = text === null;
      });
    }

    function countFlip() {
      flips++;
      const stage = stages.find((s) => s.at === flips);
      if (!stage) return;
      setTired(stage.text);
      if (stage.reset) {
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          setTired(null);
          flips = 0;
        }, 1800);
      }
    }

    function render() {
      card!.classList.toggle('is-flipped', flipped);
      // Keep the hidden face out of the tab order and the accessibility tree.
      back!.toggleAttribute('inert', !flipped);
      front!.toggleAttribute('inert', flipped);
      front!.setAttribute('aria-expanded', String(flipped));
    }

    function flip(to: boolean) {
      flipped = to;
      render();
      countFlip();
      // Move focus to the face that is now visible, after the animation has started.
      const target = flipped ? backFlip : front;
      window.setTimeout(() => target?.focus({ preventScroll: true }), reducedMotion.matches ? 0 : 350);
    }

    scene.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((btn) => {
      btn.addEventListener('click', () => flip(!flipped));
    });

    // Cursor tilt on devices with a mouse. Max ±8 degrees.
    if (finePointer.matches && !reducedMotion.matches) {
      scene.addEventListener('pointermove', (e) => {
        const r = scene.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ry', `${(x * 16).toFixed(2)}deg`);
        tilt.style.setProperty('--rx', `${(-y * 16).toFixed(2)}deg`);
      });
      scene.addEventListener('pointerleave', () => {
        tilt.style.removeProperty('--rx');
        tilt.style.removeProperty('--ry');
      });
    }

    render();
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-business-card]').forEach(setupCard);
  }

  document.addEventListener('astro:page-load', init);
</script>
