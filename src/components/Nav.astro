---
/**
 * Site header with brand mark and main navigation.
 * Mobile: fixed bottom bar with big touch targets. Desktop: inline in the header.
 */
import { SITE } from '@/data/site';
import { UI } from '@/data/ui';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '@/assets/logo.png';

const navItems = [
  { href: '/hub', label: UI.nav.home, icon: 'home' },
  { href: '/projects', label: UI.nav.projects, icon: 'grid' },
  { href: '/updates', label: UI.nav.updates, icon: 'sparkle' },
  { href: '/schedule', label: UI.nav.schedule, icon: 'calendar' },
  { href: '/links', label: UI.nav.links, icon: 'link' },
  // Fun games live on their own subdomain (see worker.js)
  { href: SITE.fun.url, label: UI.nav.fun, icon: 'games' },
];

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => current.startsWith(href);
---

<header
  class="site-header"
  data-retro-title={SITE.title}
  data-retro-boot={UI.retro.bootSub}
  data-retro-welcome={UI.retro.welcome}
  data-retro-welcome-sub={UI.retro.welcomeSub}
  data-retro-off={UI.retro.off}
  data-retro-off-sub={UI.retro.offSub}
  data-retro-exit={UI.retro.exit}
>
  <div class="container site-header__inner">
    <a class="brand" href="/hub" aria-label={`${SITE.title} home`}>
      <span class="brand__mark" aria-hidden="true">
        <Image src={logo} width={64} height={64} alt="" loading="eager" />
      </span>
      {SITE.title}
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <Icon name={item.icon} size={20} class="nav__icon" />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  /**
   * Easter egg: three quick clicks on the logo boot "XP mode", a Luna-style
   * skin defined in src/styles/retro.css. The choice is kept in localStorage
   * (Head.astro applies it before first paint on every page); three more
   * clicks, or the tray button, log off again.
   */
  const KEY = 'theme';
  const CLICKS = 3;
  const WINDOW_MS = 1500;
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let clicks = 0;
  let clickTimer: number | undefined;
  let busy = false;
  let clockTimer: number | undefined;

  const header = () => document.querySelector<HTMLElement>('.site-header');
  const text = (key: string) => header()?.dataset[key] ?? '';
  const isXp = () => document.documentElement.dataset.theme === 'xp';

  function setXp(on: boolean) {
    if (on) document.documentElement.dataset.theme = 'xp';
    else delete document.documentElement.dataset.theme;
    try {
      if (on) localStorage.setItem(KEY, 'xp');
      else localStorage.removeItem(KEY);
    } catch {
      /* private mode: the skin still works for this page */
    }
    mountTray();
  }

  function screen(kind: 'boot' | 'welcome' | 'off', title: string, sub: string, ms: number) {
    return new Promise<void>((resolve) => {
      const el = document.createElement('div');
      el.className = `xp-boot xp-boot--${kind}`;
      el.setAttribute('role', 'status');
      const inner = document.createElement('div');
      inner.className = 'xp-boot__inner';
      const brand = document.createElement('div');
      brand.className = 'xp-boot__brand';
      brand.textContent = title;
      if (kind === 'boot') {
        const tag = document.createElement('small');
        tag.textContent = 'xp';
        brand.append(tag);
      }
      const subEl = document.createElement('div');
      subEl.className = 'xp-boot__sub';
      subEl.textContent = sub;
      inner.append(brand, subEl);
      if (kind === 'boot') {
        const bar = document.createElement('div');
        bar.className = 'xp-boot__bar';
        inner.append(bar);
      }
      el.append(inner);
      document.body.append(el);
      window.setTimeout(() => {
        el.remove();
        resolve();
      }, reduced() ? Math.min(ms, 600) : ms);
    });
  }

  async function boot() {
    if (busy) return;
    busy = true;
    await screen('boot', text('retroTitle'), text('retroBoot'), 2600);
    setXp(true);
    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
    await screen('welcome', text('retroWelcome'), text('retroWelcomeSub'), 1400);
    busy = false;
  }

  async function logOff() {
    if (busy) return;
    busy = true;
    await screen('off', text('retroOff'), text('retroOffSub'), 1500);
    setXp(false);
    busy = false;
  }

  function mountTray() {
    const host = header()?.querySelector<HTMLElement>('.site-header__inner');
    const existing = host?.querySelector<HTMLElement>('.xp-tray');
    if (!isXp()) {
      existing?.remove();
      window.clearInterval(clockTimer);
      return;
    }
    if (!host || existing) return;
    const tray = document.createElement('div');
    tray.className = 'xp-tray';
    const exit = document.createElement('button');
    exit.type = 'button';
    exit.className = 'xp-tray__exit';
    exit.textContent = text('retroExit');
    exit.addEventListener('click', logOff);
    const clock = document.createElement('span');
    clock.className = 'xp-tray__clock';
    const tick = () => {
      clock.textContent = new Date().toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' });
    };
    tick();
    window.clearInterval(clockTimer);
    clockTimer = window.setInterval(tick, 15000);
    tray.append(exit, clock);
    host.append(tray);
  }

  document.addEventListener('click', (e) => {
    const brand = (e.target as Element | null)?.closest('.brand');
    if (!brand) return;
    clicks += 1;
    window.clearTimeout(clickTimer);
    clickTimer = window.setTimeout(() => (clicks = 0), WINDOW_MS);
    if (clicks < CLICKS) return;
    clicks = 0;
    e.preventDefault();
    if (isXp()) logOff();
    else boot();
  });

  document.addEventListener('astro:page-load', mountTray);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--line) solid var(--ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  /* The logo brings its own border, so the hard shadow is a drop-shadow on the image */
  .brand__mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    filter: drop-shadow(2px 2px 0 var(--ink));
    transform: rotate(-6deg);
    transition: transform var(--t-base) var(--ease-pop);
  }

  .brand__mark img {
    width: 100%;
    height: 100%;
  }

  .brand:hover .brand__mark {
    transform: rotate(8deg) scale(1.1);
  }

  .nav ul {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2);
    padding-bottom: max(var(--space-2), env(safe-area-inset-bottom));
    list-style: none;
    background: var(--surface);
    border-top: var(--line) solid var(--ink);
  }

  .nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 48px;
    padding: var(--space-1) 2px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: var(--line) solid transparent;
    border-radius: var(--radius);
    transition:
      transform var(--t-fast) var(--ease-pop),
      box-shadow var(--t-fast) var(--ease-pop);
  }

  .nav a[aria-current='page'] {
    background: var(--c-yellow);
    border-color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .nav a:hover {
    border-color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 640px) {
    .nav ul {
      position: static;
      display: flex;
      gap: var(--space-2);
      padding: 0;
      background: none;
      border: 0;
    }

    .nav a {
      flex-direction: row;
      gap: var(--space-2);
      min-height: 40px;
      padding: var(--space-1) var(--space-3);
      font-size: var(--text-base);
    }

    .nav :global(.nav__icon) {
      display: none;
    }
  }
</style>
