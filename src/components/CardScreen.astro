---
/**
 * Full-screen business card: what visitors see on / and what the printed QR code
 * opens (/card?src=print). Card, optional greeting for scanned cards, one button into the hub.
 */
import BusinessCard from './BusinessCard.astro';
import Button from './Button.astro';
import { UI } from '@/data/ui';
---

<div class="card-page">
  <BusinessCard standalone />
  <p class="card-page__note meta" data-print-note hidden>{UI.card.scanned}</p>
  <Button href="/hub" color="--surface" iconAfter="arrow" size="lg">{UI.card.visit}</Button>
</div>

<style>
  .card-page {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    width: 100%;
  }

  .card-page__note {
    text-align: center;
  }

  .card-page__note[hidden] {
    display: none;
  }
</style>

<script>
  // Show a small greeting when someone arrives via the printed QR code.
  document.addEventListener('astro:page-load', () => {
    const note = document.querySelector<HTMLElement>('[data-print-note]');
    if (note && new URLSearchParams(location.search).get('src') === 'print') note.hidden = false;
  });
</script>
